@model Sugentra.ERP.UI.Models.Settings.EmailSetting
@{
    ViewData["Title"] = "Email Setting";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-mail-settings-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("System Administration", Url.Action("Index", "Workspace", new { id =
"SystemAdministration" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Email Settings", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Edit", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <h5 class="mb-0">Edit Email Setting</h5>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                <form method="post" id="emailSettingForm">
                    <input type="hidden" asp-for="Id" />
                    <div class="row mb-3">
                        <label asp-for="Name" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Name" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Provider" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Provider" class="form-control form-control-sm"
                                   placeholder="e.g. Smtp, Gmail, Outlook365" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Host" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Host" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Port" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Port" type="number" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="TimeoutSeconds" class="col-sm-3 col-form-label col-form-label-sm">Timeout
                            (s)</label>
                            <div class="col-sm-9">
                                <input asp-for="TimeoutSeconds" type="number" class="form-control form-control-sm"
                                       required />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="ConnectionSecurity" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <select asp-for="ConnectionSecurity" class="form-select form-select-sm">
                                    <option value="None">None</option>
                                    <option value="SslOnConnect">SSL on Connect</option>
                                    <option value="StartTls">StartTLS</option>
                                    <option value="StartTlsWhenAvailable">StartTLS When Available</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Username" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <input asp-for="Username" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Password" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <input asp-for="Password" type="password" class="form-control form-control-sm"
                                       autocomplete="new-password" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="IsActive" class="col-sm-3 col-form-label col-form-label-sm">Active</label>
                            <div class="col-sm-9">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-label-dark waves-effect btn-filter-action">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-filter-action">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between">
                        <h5 class="mb-0">Test Connection</h5>
                    </div>
                </div>
                <div class="card-body">
                    <div id="testConnectionAlert" class="alert d-none" role="alert"></div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Send To</label>
                        <div class="col-sm-9">
                            <input id="testToEmail" type="email" class="form-control form-control-sm"
                                   placeholder="recipient@example.com" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Subject</label>
                        <div class="col-sm-9">
                            <input id="testSubject" type="text" class="form-control form-control-sm"
                                   value="Sugentra ERP — Test Email" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label col-form-label-sm">Body</label>
                        <div class="col-sm-9">
                            <textarea id="testBody" rows="3"
                                      class="form-control form-control-sm">This is a test email sent from the '@Model.Name' email setting to verify the SMTP configuration.</textarea>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" id="testConnectionBtn" class="btn btn-label-dark waves-effect">
                            Test Connection
                        </button>
                    </div>
                    @if (Model.LastTestedAt is not null)
                    {
                        <div class="mt-3">
                            <small class="text-muted">Last tested @Model.LastTestedAt?.ToString("yyyy-MM-dd HH:mm:ss") —
                                @Model.LastTestStatus @(Model.LastTestMessage is null ? "" :
                                $"({Model.LastTestMessage})")</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                document.getElementById('testConnectionBtn').addEventListener('click', async function () {
                    const btn = this;
                    const alertBox = document.getElementById('testConnectionAlert');
                    const toEmail = document.getElementById('testToEmail').value.trim();

                    alertBox.classList.add('d-none');
                    if (!toEmail) {
                        alertBox.classList.remove('d-none', 'alert-success');
                        alertBox.classList.add('alert-danger');
                        alertBox.textContent = 'Please enter a recipient email address.';
                        return;
                    }

                    const formData = new FormData(document.getElementById('emailSettingForm'));
                    formData.append('toEmail', toEmail);
                    formData.append('subject', document.getElementById('testSubject').value.trim());
                    formData.append('body', document.getElementById('testBody').value.trim());

                    btn.disabled = true;
                    btn.textContent = 'Sending...';
                    try {
                        const response = await fetch('@Url.Action("Test")', { method: 'POST', body: formData });
                        const result = await response.json();
                        alertBox.classList.remove('d-none', 'alert-primary', 'alert-danger');
                        alertBox.classList.add(result.success ? 'alert-primary' : 'alert-danger');
                        let text = result.message || (result.success ? 'Test email sent successfully.' : 'Test failed.');
                        if (result.errors) {
                            text += ' ' + Object.values(result.errors).flat().join(' ');
                        }
                        alertBox.textContent = text;
                    } catch (err) {
                        alertBox.classList.remove('d-none', 'alert-success');
                        alertBox.classList.add('alert-danger');
                        alertBox.textContent = 'Unexpected error while testing the connection.';
                    } finally {
                        btn.disabled = false;
                        btn.textContent = 'Test Connection';
                    }
                });
            </script>
        }

