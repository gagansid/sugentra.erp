@model Sugentra.ERP.UI.Models.Settings.EmailSetting
@{
    ViewData["Title"] = "Email Setting";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-mail-settings-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("System Administration", Url.Action("Index", "Workspace", new { id =
"SystemAdministration" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Email Settings", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Create", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <h5 class="card-header">Create Email Setting</h5>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row mb-3">
                        <label asp-for="Name" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Name" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Provider" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Provider" class="form-control form-control-sm"
                                   placeholder="e.g. Smtp, Gmail, Outlook365" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Host" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Host" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Port" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Port" type="number" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="TimeoutSeconds" class="col-sm-3 col-form-label col-form-label-sm">Timeout
                            (s)</label>
                            <div class="col-sm-9">
                                <input asp-for="TimeoutSeconds" type="number" class="form-control form-control-sm"
                                       required />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="ConnectionSecurity" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <select asp-for="ConnectionSecurity" class="form-select form-select-sm">
                                    <option value="None">None</option>
                                    <option value="SslOnConnect">SSL on Connect</option>
                                    <option value="StartTls">StartTLS</option>
                                    <option value="StartTlsWhenAvailable">StartTLS When Available</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Username" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <input asp-for="Username" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Password" class="col-sm-3 col-form-label col-form-label-sm"></label>
                            <div class="col-sm-9">
                                <input asp-for="Password" type="password" class="form-control form-control-sm"
                                       autocomplete="new-password" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="IsActive" class="col-sm-3 col-form-label col-form-label-sm">Active</label>
                            <div class="col-sm-9">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-label-dark waves-effect btn-filter-action">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-filter-action">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

