@model List<Sugentra.ERP.UI.Models.Approvals.ApprovalRoleCategoryResponse>
@{
    ViewData["Title"] = "Approval Role Categories";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-shield-user-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Approvals", Url.Action("Index", "Workspace", new { id = "Approvals" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Role Categories", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Approval Role Categories</h5>
        @if (User.HasPermission("ApprovalRoleCategory_Create"))
        {
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add Data</a>
        }
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Role Id</th>
                    <th>Document Type</th>
                    <th class="text-center" style="width: 80px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center">No approval role categories configured.</td>
                    </tr>
                }
                else
                {
                    var rowNo = 0;
                    @foreach (var item in Model)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@item.RoleId</td>
                            <td>@item.DocumentType</td>
                            <td class="text-center">
                                @if (User.HasPermission("ApprovalRoleCategory_Delete"))
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Delete this approval role category?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-label-danger" title="Delete">
                                            <i class="ri ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
