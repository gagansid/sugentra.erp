@model Sugentra.ERP.UI.Models.Approvals.ApprovalFlowDefinitionResponse
@{
    var isEdit = Model.Id > 0;
    var allRoles = (ViewData["AllRoles"] as IReadOnlyList<Sugentra.ERP.UI.Models.Identity.RoleListItemDto>) ?? [];
    var allUsers = (ViewData["AllUsers"] as IReadOnlyList<Sugentra.ERP.UI.Models.Identity.UserListItemDto>) ?? [];
    var approverTypes = (ViewData["ApproverTypes"] as IReadOnlyList<Sugentra.ERP.UI.Models.Approvals.ApproverTypeOption>) ?? [];
    var formId = isEdit ? "approvalFlowEditForm" : "approvalFlowCreateForm";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@(isEdit ? "Edit" : "Add") Approval Flow</h5>
    </div>
    <div class="card-body">
        <form id="@formId" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" novalidate>
            @Html.AntiForgeryToken()

            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Approver Type</label>
                <div class="col-md-4 col-sm-8">
                    <select name="approverType" id="approverTypeSelect" class="selectpicker form-control form-control-sm"
                            data-style="btn-default" data-width="100%" data-container="body" data-live-search="true"
                            required data-required-message="Approver type is required.">
                        <option value="">-- Select Approver Type --</option>
                        @foreach (var type in approverTypes)
                        {
                            <option value="@type.ApproverType" selected="@(type.ApproverType == Model.ApproverType ? "selected" : null)">
                                @(string.IsNullOrWhiteSpace(type.Description) ? type.ApproverType : $"{type.ApproverType} ({type.Description})")
                            </option>
                        }
                        @if (isEdit && !approverTypes.Any(t => t.ApproverType == Model.ApproverType))
                        {
                            <option value="@Model.ApproverType" selected>@Model.ApproverType</option>
                        }
                    </select>
                    <span class="text-danger small"></span>
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Name</label>
                <div class="col-md-4 col-sm-8">
                    <input type="text" name="name" class="form-control form-control-sm" value="@Model.Name"
                           required data-required-message="Name is required." />
                    <span class="text-danger small"></span>
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Min Amount</label>
                <div class="col-md-4 col-sm-8">
                    <input type="number" step="0.01" name="minAmount" class="form-control form-control-sm" value="@Model.MinAmount" />
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Max Amount</label>
                <div class="col-md-4 col-sm-8">
                    <input type="number" step="0.01" name="maxAmount" class="form-control form-control-sm" value="@Model.MaxAmount" />
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Currency Id</label>
                <div class="col-md-4 col-sm-8">
                    <input type="number" name="currencyId" class="form-control form-control-sm" value="@Model.CurrencyId" />
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Warehouse Id</label>
                <div class="col-md-4 col-sm-8">
                    <input type="number" name="warehouseId" class="form-control form-control-sm" value="@Model.WarehouseId" />
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Priority</label>
                <div class="col-md-4 col-sm-8">
                    <input type="number" name="priority" class="form-control form-control-sm" value="@Model.Priority" />
                </div>
            </div>
            <div class="row align-items-center">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Active</label>
                <div class="col-md-4 col-sm-8 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActive" checked="@(Model.IsActive ? "checked" : null)" />
                        <input type="hidden" name="isActive" value="false" />
                    </div>
                </div>
            </div>

            <hr />

            <h6 class="mb-2">Approval Levels</h6>
            <p class="text-muted small">Pick Role(s) and/or User(s) eligible to approve at that level. A level needs at least one of the two. Roles listed are limited to those configured under Settings &gt; Approval Types.</p>
            <div class="row g-2 mb-1">
                <label class="col-md-1 form-label mb-0 small">Level #</label>
                <label class="col-md-2 form-label mb-0 small">Level Name</label>
                <label class="col-md-2 form-label mb-0 small">Require All?</label>
                <label class="col-md-3 form-label mb-0 small">Role(s)</label>
                <label class="col-md-4 form-label mb-0 small">User(s)</label>
            </div>
            <div id="levelsContainer"></div>
            <button type="button" id="addLevelBtn" class="btn btn-sm btn-label-primary mb-2">
                <i class="ri ri-add-line me-1"></i>Add Level
            </button>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Cancel</a>
        <button type="submit" form="@formId" class="btn btn-sm btn-primary btn-filter-action">Save</button>
    </div>
</div>

<template id="levelRowTemplate">
    <div class="row g-2 align-items-start mb-3 level-row">
        <div class="col-md-1">
            <input type="number" name="levelNumber" class="form-control form-control-sm level-number" required />
        </div>
        <div class="col-md-2">
            <input type="text" name="levelName" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-2">
            <select name="requireAllApprovers" class="selectpicker form-control form-control-sm"
                    data-style="btn-default" data-width="100%">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="roleIds" class="selectpicker form-control form-control-sm role-ids-select" multiple
                    data-live-search="true" data-style="btn-default" data-width="100%" data-container="body">
                @foreach (var role in allRoles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <div class="input-group input-group-sm user-ids-group">
                <select name="userIds" class="selectpicker form-control form-control-sm user-ids-select ids-select" multiple
                        data-live-search="true" data-style="btn-default" data-width="100%" data-container="body">
                    @foreach (var user in allUsers)
                    {
                        <option value="@user.Id">@user.FullName</option>
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-danger remove-level-btn" data-bs-toggle="tooltip" title="Remove">
                    <i class="ri ri-delete-bin-line icon-14px"></i>
                </button>
            </div>
        </div>
    </div>
</template>

<script>
    (function () {
            const levelsContainer = document.getElementById('levelsContainer');
            const template = document.getElementById('levelRowTemplate');
            const addLevelBtn = document.getElementById('addLevelBtn');
            const form = document.getElementById('@formId');
            if (!levelsContainer || !template || !addLevelBtn || !form) {
                return;
            }

            function addLevelRow(level) {
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('.level-row');
                row.querySelector('.level-number').value = level?.levelNumber ?? (levelsContainer.children.length + 1);
                row.querySelector('[name="levelName"]').value = level?.name ?? '';
                row.querySelector('[name="requireAllApprovers"]').value = (level?.requireAllApprovers ?? true) ? 'true' : 'false';

                const roleSelect = row.querySelector('.role-ids-select');
                (level?.roleIds ?? '').split(',').filter(Boolean).forEach(function (id) {
                    const opt = roleSelect.querySelector('option[value="' + id + '"]');
                    if (opt) opt.selected = true;
                });

                const userSelect = row.querySelector('.user-ids-select');
                (level?.userIds ?? '').split(',').filter(Boolean).forEach(function (id) {
                    const opt = userSelect.querySelector('option[value="' + id + '"]');
                    if (opt) opt.selected = true;
                });

                row.querySelector('.remove-level-btn').addEventListener('click', () => row.remove());
                levelsContainer.appendChild(row);
                initSelectpickers();
            }

            addLevelBtn.addEventListener('click', function (event) {
                event.preventDefault();
                addLevelRow(null);
            });

            const existingLevels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.Levels ?? []).Select(l => new
            {
                levelNumber = l.LevelNumber,
                name = l.Name,
                requireAllApprovers = l.RequireAllApprovers,
                roleIds = string.Join(",", (l.Approvers ?? []).Where(a => a.RoleId.HasValue).Select(a => a.RoleId)),
                userIds = string.Join(",", (l.Approvers ?? []).Where(a => a.UserId.HasValue).Select(a => a.UserId))
            })));

            if (existingLevels.length > 0) {
                existingLevels.forEach(addLevelRow);
            } else {
                addLevelRow(null);
            }

            function fieldMessageEl(field) {
                return field.closest('.col-md-4, .col-sm-8')?.querySelector('.text-danger');
            }

            function clearFieldMessage(field) {
                if (field.checkValidity && !field.checkValidity()) return;
                const msgEl = fieldMessageEl(field);
                if (msgEl) msgEl.textContent = '';
            }

            form.querySelectorAll('[required]').forEach(function (field) {
                field.addEventListener('input', function () { clearFieldMessage(field); });
                field.addEventListener('change', function () { clearFieldMessage(field); });
            });

            form.addEventListener('submit', function (event) {
                let hasError = false;
                form.querySelectorAll('[required]').forEach(function (field) {
                    const msgEl = fieldMessageEl(field);
                    if (!field.checkValidity()) {
                        if (msgEl) msgEl.textContent = field.dataset.requiredMessage || 'This field is required.';
                        hasError = true;
                    } else if (msgEl) {
                        msgEl.textContent = '';
                    }
                });

                if (hasError) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            });

            window.addEventListener('load', function () {
                initSelectpickers();
            });
        })();
    </script>
