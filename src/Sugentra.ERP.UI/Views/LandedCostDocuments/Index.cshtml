@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Inventory.LandedCostDocumentResponse>
@{
    ViewData["Title"] = "Landed Cost Documents";
    var receipts = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.GoodsReceiptResponse>)ViewBag.GoodsReceipts;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-coin-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Landed Cost Documents", null)
    });
    var hasAdvancedFilter = !string.IsNullOrEmpty(ViewBag.Status as string);
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Landed Cost Documents</h5>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 mb-2">
        @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        <form method="get" id="landedCostDocumentsFilterForm" class="d-flex align-items-center gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   style="width: 250px;" value="@ViewBag.Keyword" placeholder="Search document number.." />
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-primary position-relative"
                        id="landedCostDocumentsFilterDropdown" data-bs-toggle="dropdown"
                        data-bs-auto-close="outside" aria-expanded="@(hasAdvancedFilter ? "true" : "false")">
                    <i class="ri ri-filter-3-line me-1"></i>Filter
                    @if (hasAdvancedFilter)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                            <span class="visually-hidden">Filter active</span>
                        </span>
                    }
                </button>
                <div class="dropdown-menu dropdown-menu-end w-px-350 p-0" aria-labelledby="landedCostDocumentsFilterDropdown">
                    <div class="card mb-0 shadow-none">
                        <div class="card-header py-2">
                            <h6 class="mb-3">Filter</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-12 mb-2">
                                    <label class="form-label mb-1 small">Status</label>
                                    <select name="status" class="form-select form-select-sm">
                                        <option value="">All Status</option>
                                        <option value="Draft" selected="@("Draft".Equals(ViewBag.Status) ? "selected" : null)">Draft</option>
                                        <option value="Posted" selected="@("Posted".Equals(ViewBag.Status) ? "selected" : null)">Posted</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Clear</a>
                            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
            @if (User.HasPermission("Batch_Create"))
            {
                <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add New</a>
            }
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Document Number</th>
                    <th>Goods Receipt</th>
                    <th>Allocation Method</th>
                    <th class="col-fit">Status</th>
                    <th class="text-center" style="width: 80px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center">No landed cost documents recorded.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var document in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td><a asp-action="Detail" asp-route-id="@document.Id">@document.DocumentNumber</a></td>
                            <td>@(receipts.FirstOrDefault(r => r.Id == document.GoodsReceiptId)?.ReceiptNumber)</td>
                            <td>@document.AllocationMethod</td>
                            <td>
                                <span class="badge bg-label-@(document.Status == "Posted" ? "primary" : "secondary")">@document.Status</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Detail" asp-route-id="@document.Id" class="btn btn-icon btn-text-secondary"
                                   data-bs-toggle="tooltip" title="View"><i class="ri ri-eye-line icon-14px"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>
