@{
    ViewData["Title"] = "Add Landed Cost Document";
    var receipts = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.GoodsReceiptResponse>)ViewBag.GoodsReceipts;
    var currencies = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Currency>)ViewBag.Currencies;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-coin-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Landed Cost Documents", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Create", null)
    });
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form id="landedCostDocumentForm" method="post" novalidate>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Goods Receipt</label>
                <div class="col-md-4 col-sm-8">
                    <select name="goodsReceiptId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%" required data-required-message="Goods receipt is required.">
                        <option value="" selected disabled>-- Select Goods Receipt --</option>
                        @foreach (var receipt in receipts)
                        {
                            <option value="@receipt.Id">@receipt.ReceiptNumber</option>
                        }
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2 mb-3">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Notes</label>
                <div class="col-md-4 col-sm-8"><textarea name="notes" class="form-control form-control-sm" rows="3"></textarea></div>
            </div>

            <h6 class="mb-3">Cost Lines</h6>
            <div class="row g-2 mb-1">
                <label class="col-md-3 form-label mb-0 small required-label">Cost Type</label>
                <label class="col-md-3 form-label mb-0 small required-label">Amount</label>
                <label class="col-md-3 form-label mb-0 small required-label">Currency</label>
                <label class="col-md-3 form-label mb-0 small">Notes</label>
            </div>
            <div id="lines">
                <div class="row g-2 mb-2 line-row cost-line-row">
                    <div class="col-md-3">
                        <select name="costType" class="form-select form-select-sm" required data-required-message="Cost type is required.">
                            @foreach (var costType in new[] { "Freight", "Insurance", "Handling", "Duty", "Other" })
                            {
                                <option value="@costType">@costType</option>
                            }
                        </select>
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-3">
                        <input name="amount" type="number" step="0.01" class="form-control form-control-sm"
                               placeholder="Amount" required data-required-message="Amount is required." />
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-3">
                        <select name="currencyId" class="form-select form-select-sm" required data-required-message="Currency is required.">
                            <option value="" selected disabled>-- Select Currency --</option>
                            @foreach (var currency in currencies)
                            {
                                <option value="@currency.Id">@currency.Code</option>
                            }
                        </select>
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group input-group-sm line-notes-group">
                            <input name="lineNotes" class="form-control form-control-sm" placeholder="Notes" />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" data-bs-toggle="tooltip" title="Remove">
                                <i class="ri ri-delete-bin-line icon-14px"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" id="addLine" class="btn btn-sm btn-outline-primary mb-4">+ Add Line</button>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
        <button type="submit" form="landedCostDocumentForm" class="btn btn-primary btn-sm btn-filter-action">Save</button>
    </div>
</div>

@section Scripts {
    <script>
        $('.gr-select').selectpicker();

        document.getElementById('addLine').addEventListener('click', function () {
            var lines = document.getElementById('lines');
            var clone = lines.firstElementChild.cloneNode(true);
            clone.querySelectorAll('input').forEach(function (i) { i.value = ''; });
            clone.querySelectorAll('select').forEach(function (s) { s.selectedIndex = 0; });
            clone.querySelectorAll('.line-error').forEach(function (e) { e.textContent = ''; });
            lines.appendChild(clone);
        });

        document.getElementById('lines').addEventListener('click', function (e) {
            var button = e.target.closest('.remove-line');
            if (!button) return;
            var lines = document.getElementById('lines');
            if (lines.children.length > 1) {
                button.closest('.line-row').remove();
            }
        });

        document.getElementById('landedCostDocumentForm').addEventListener('submit', function (event) {
            var valid = true;
            this.querySelectorAll('[required]').forEach(function (field) {
                var isValid = field.checkValidity();
                var errorEl = field.closest('.col-md-3, .col-md-4')?.querySelector('.line-error');
                if (errorEl) errorEl.textContent = isValid ? '' : field.dataset.requiredMessage;
                valid = valid && isValid;
            });
            if (!valid) {
                event.preventDefault();
                event.stopPropagation();
            }
        });
    </script>
}
