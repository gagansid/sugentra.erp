@{
    ViewData["Title"] = "Add Purchase Order";
    var vendors = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.BusinessPartnerResponse>)ViewBag.Vendors;
    var currencies = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Currency>)ViewBag.Currencies;
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var requisitions = (IReadOnlyList<Sugentra.ERP.UI.Models.Procurement.PurchaseRequisitionResponse>)ViewBag.ApprovedRequisitions;
    var selectedRequisitionIds = ((List<long>?)ViewBag.SelectedRequisitionIds) ?? [];
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-shopping-cart-2-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Procurement", Url.Action("Index", "Workspace", new { id = "Procurement" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Purchase Orders", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Create", null)
    });
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form id="orderForm" method="post" novalidate>
            <div class="row g-2 gx-5">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Source Requisition</label>
                <div class="col-md-4 col-sm-8">
                    <select name="purchaseRequisitionIds" id="purchaseRequisitionSelect" class="selectpicker form-control form-control-sm gr-select"
                            multiple data-live-search="true" data-style="btn-default" data-width="100%" data-selected-text-format="count > 2">
                        @foreach (var pr in requisitions)
                        {
                            @* Fully ordered PRs have nothing left to order, so hide them unless already selected (e.g. redisplay after a validation error). *@
                            if (pr.OrderStatus != "FullyOrdered" || selectedRequisitionIds.Contains(pr.Id))
                            {
                                <option value="@pr.Id" selected="@(selectedRequisitionIds.Contains(pr.Id) ? "selected" : null)">
                                    @(pr.RequisitionNumber)@(pr.OrderStatus == "PartiallyOrdered" ? " (Partially Ordered)" : "")
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2 gx-5">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Vendor</label>
                <div class="col-md-4 col-sm-8">
                    <select name="vendorId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%" required data-required-message="Vendor is required.">
                        <option value="" selected disabled>-- Select Vendor --</option>
                        @foreach (var v in vendors)
                        {
                            <option value="@v.Id">@v.Code - @v.Name</option>
                        }
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Currency</label>
                <div class="col-md-4 col-sm-8">
                    <select name="currencyId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%" required data-required-message="Currency is required.">
                        <option value="" selected disabled>-- Select Currency --</option>
                        @foreach (var c in currencies)
                        {
                            <option value="@c.Id">@c.Code - @c.Name</option>
                        }
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2 gx-5">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Payment Term (Days)</label>
                <div class="col-md-4 col-sm-8">
                    <input name="paymentTermDays" type="number" class="form-control form-control-sm" />
                </div>
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Expected Delivery</label>
                <div class="col-md-4 col-sm-8">
                    <div class="input-group input-group-sm received-date-group">
                        <input name="expectedDeliveryDate" type="text" class="form-control form-control-sm received-date-flatpickr"
                               autocomplete="off" />
                        <span class="input-group-text received-date-toggle"><i class="ri ri-calendar-line"></i></span>
                    </div>
                </div>
            </div>
            <div class="row g-2 gx-5">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Order Date</label>
                <div class="col-md-4 col-sm-8">
                    <div class="input-group input-group-sm received-date-group">
                        <input name="orderDate" type="text" class="form-control form-control-sm received-date-flatpickr"
                               autocomplete="off" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required data-required-message="Order date is required." />
                        <span class="input-group-text received-date-toggle"><i class="ri ri-calendar-line"></i></span>
                    </div>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2 gx-5">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Notes</label>
                <div class="col-md-4 col-sm-8"><textarea name="notes" class="form-control form-control-sm" rows="4"></textarea></div>
            </div>

            <h6 class="mb-3">Lines</h6>
            <div class="row g-2 mb-1">
                <label class="col-md-3 form-label mb-0 small required-label">Item</label>
                <label class="col-md-2 form-label mb-0 small required-label">Warehouse</label>
                <label class="col-md-2 form-label mb-0 small required-label">Quantity</label>
                <label class="col-md-1 form-label mb-0 small">Max Qty</label>
                <label class="col-md-2 form-label mb-0 small required-label">Unit Price</label>
                <label class="col-md-2 form-label mb-0 small">Discount (%)</label>
            </div>
            <div id="lines">
                <div class="row g-2 mb-2 line-row">
                    <div class="col-md-3">
                        <select name="itemId" class="selectpicker form-control form-control-sm gr-select item-select"
                                data-live-search="true" data-style="btn-default" data-width="100%" required
                                data-required-message="Item is required.">
                            <option value="" selected disabled>-- Select Item --</option>
                            @foreach (var item in items)
                            {
                                <option value="@item.Id">@item.Code - @item.Name</option>
                            }
                        </select>
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-2">
                        <select name="warehouseId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                                data-style="btn-default" data-width="100%" required data-required-message="Warehouse is required.">
                            <option value="" selected disabled>-- Select --</option>
                            @foreach (var w in warehouses)
                            {
                                <option value="@w.Id">@w.Code</option>
                            }
                        </select>
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-2">
                        <input name="quantity" type="number" step="0.01" class="form-control form-control-sm line-quantity"
                               placeholder="Qty" required data-required-message="Quantity is required." />
                        <input type="hidden" name="sourcesJson" class="line-sources-json" value="[]" />
                        <div class="text-danger small line-error"></div>
                        <div class="mt-1 line-source-hint"></div>
                    </div>
                    <div class="col-md-1">
                        <input type="text" class="form-control form-control-sm line-max-qty" value="-" readonly tabindex="-1" />
                    </div>
                    <div class="col-md-2">
                        <input name="unitPrice" type="number" step="0.01" class="form-control form-control-sm"
                               placeholder="Price" required data-required-message="Unit price is required." />
                        <div class="text-danger small line-error"></div>
                    </div>
                    <div class="col-md-2">
                        <div class="input-group input-group-sm has-validation po-line-group">
                            <input name="discountPercent" type="number" step="0.01" class="form-control form-control-sm" placeholder="0" />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" data-bs-toggle="tooltip"
                                    title="Remove">
                                <i class="ri ri-delete-bin-line icon-14px"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" id="addLine" class="btn btn-sm btn-outline-primary mb-4">+ Add Line</button>
        </form>

        <div class="modal fade" id="prDetailModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Purchase Requisition Detail</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" id="prDetailModalBody"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
        <button type="submit" form="orderForm" class="btn btn-primary btn-sm btn-filter-action">Save</button>
    </div>
</div>

@section Scripts {
    <script>
        var requisitionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(requisitions.ToDictionary(
            pr => pr.Id.ToString(),
            pr => new
            {
                requisitionNumber = pr.RequisitionNumber,
                requisitionDate = pr.RequisitionDate.ToString("yyyy-MM-dd"),
                requesterName = pr.RequesterName,
                warehouseId = pr.WarehouseId,
                notes = pr.Notes,
                lines = pr.Lines.Select(l => new { lineId = l.Id, itemId = l.ItemId, itemCode = l.ItemCode, itemName = l.ItemName, quantity = l.Quantity, orderedQuantity = l.OrderedQuantity, remainingQuantity = Math.Max(0, l.Quantity - l.OrderedQuantity), notes = l.Notes })
            })));
        var requisitionNumbers = {};
        Object.keys(requisitionData).forEach(function (id) { requisitionNumbers[id] = requisitionData[id].requisitionNumber; });

        function showPrDetailModal(requisitionId) {
            var pr = requisitionData[requisitionId];
            if (!pr) return;
            var linesHtml = pr.lines.map(function (l) {
                return '<tr><td>' + (l.itemCode ? l.itemCode + ' - ' + l.itemName : l.itemName) + '</td>'
                    + '<td class="text-end">' + l.quantity + '</td>'
                    + '<td>' + (l.notes || '') + '</td></tr>';
            }).join('');
            var html = '<div class="row g-2 mb-3">'
                + '<div class="col-md-6"><strong>Requisition No.</strong><div>' + pr.requisitionNumber + '</div></div>'
                + '<div class="col-md-6"><strong>Date</strong><div>' + pr.requisitionDate + '</div></div>'
                + '<div class="col-md-6"><strong>Requester</strong><div>' + (pr.requesterName || '-') + '</div></div>'
                + '<div class="col-md-6"><strong>Notes</strong><div>' + (pr.notes || '-') + '</div></div>'
                + '</div>'
                + '<table class="table table-sm"><thead><tr><th>Item</th><th class="text-end">Quantity</th><th>Notes</th></tr></thead>'
                + '<tbody>' + linesHtml + '</tbody></table>';
            document.getElementById('prDetailModalBody').innerHTML = html;
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('prDetailModal'));
            modal.show();
        }

        document.addEventListener('click', function (e) {
            var badge = e.target.closest('.pr-source-badge');
            if (!badge) return;
            showPrDetailModal(badge.dataset.requisitionId);
        });

        function initSelectPickers($scope) {
            $scope.find('select.gr-select').each(function () {
                var $select = $(this);
                if ($select.closest('.bootstrap-select').length) {
                    $select.selectpicker('destroy');
                }
                $select.selectpicker();
            });
        }

        $(function () {
            initSelectPickers($(document));
            $('.received-date-flatpickr').each(function () {
                var picker = flatpickr(this, { dateFormat: 'Y-m-d', allowInput: true, appendTo: document.body });
                $(this).closest('.received-date-group').find('.received-date-toggle').on('click', function () {
                    picker.open();
                });
            });

            $('#purchaseRequisitionSelect').on('changed.bs.select change', function () {
                applyRequisitionSelection($(this).val() || []);
            });
            var initialSelection = $('#purchaseRequisitionSelect').val();
            if (initialSelection && initialSelection.length > 0) {
                applyRequisitionSelection(initialSelection);
            }
        });

        function setFieldError(field, message) {
            var errorEl = field.closest('.col-md-2, .col-md-3, .col-md-4, .col-sm-8')?.querySelector('.line-error');
            if (errorEl) errorEl.textContent = message || '';
        }

        // Captured before any mutation so the blank row shape stays available after lines are replaced.
        var lineRowTemplate = document.getElementById('lines').firstElementChild.cloneNode(true);

        function blankLineRow() {
            var clone = lineRowTemplate.cloneNode(true);
            clone.querySelectorAll('.bootstrap-select').forEach(function (wrapper) {
                wrapper.replaceWith(wrapper.querySelector('select'));
            });
            clone.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
            clone.querySelectorAll('input').forEach(function (i) { i.value = ''; });
            clone.querySelectorAll('select').forEach(function (s) { s.value = ''; });
            clone.querySelector('.line-sources-json').value = '[]';
            return clone;
        }

        function appendLine(prefill) {
            var lines = document.getElementById('lines');
            var row = blankLineRow();
            setRowMax(row, prefill ? prefill.maxQuantity : undefined);
            if (prefill) {
                if (prefill.itemId) row.querySelector('select[name="itemId"]').value = prefill.itemId;
                if (prefill.warehouseId) row.querySelector('select[name="warehouseId"]').value = prefill.warehouseId;
                if (prefill.quantity) row.querySelector('input[name="quantity"]').value = prefill.quantity;
                setRowSources(row, prefill.sources || []);
            }
            lines.appendChild(row);
            initSelectPickers($(row));
        }

        // Shows the remaining orderable quantity (sum of unordered PR-line quantity) for a merged/sourced row.
        function setRowMax(row, maxQuantity) {
            var maxField = row.querySelector('.line-max-qty');
            if (typeof maxQuantity === 'number') {
                maxField.value = maxQuantity;
                row.dataset.maxQuantity = maxQuantity;
            } else {
                maxField.value = '-';
                delete row.dataset.maxQuantity;
            }
        }

        // Renders the hidden per-requisition breakdown for a merged line plus badges below Quantity.
        function setRowSources(row, sources) {
            row.querySelector('.line-sources-json').value = JSON.stringify(sources);
            var hint = row.querySelector('.line-source-hint');
            hint.innerHTML = sources.length > 1
                ? sources.map(function (s) {
                    var label = requisitionNumbers[s.purchaseRequisitionId] || ('PR-' + s.purchaseRequisitionId);
                    return '<span class="badge bg-label-info me-1 mb-1 pr-source-badge" style="font-size: 0.7rem; cursor: pointer;" data-requisition-id="' + s.purchaseRequisitionId + '">' + label + ': ' + s.quantity + '</span>';
                }).join('')
                : '';
        }

        // Proportionally redistributes a merged line's sourced quantities when the user edits the total by hand.
        function rescaleRowSources(row) {
            var sources = JSON.parse(row.querySelector('.line-sources-json').value || '[]');
            if (sources.length === 0) return;
            var originalTotal = sources.reduce(function (sum, s) { return sum + s.quantity; }, 0);
            var newTotal = parseFloat(row.querySelector('input[name="quantity"]').value) || 0;
            if (originalTotal <= 0 || newTotal === originalTotal) return;
            var ratio = newTotal / originalTotal;
            var scaled = sources.map(function (s) { return { purchaseRequisitionId: s.purchaseRequisitionId, purchaseRequisitionLineId: s.purchaseRequisitionLineId, quantity: Math.round(s.quantity * ratio * 100) / 100 }; });
            var scaledTotal = scaled.reduce(function (sum, s) { return sum + s.quantity; }, 0);
            scaled[scaled.length - 1].quantity += Math.round((newTotal - scaledTotal) * 100) / 100;
            setRowSources(row, scaled);
        }

        // A PR-sourced row can't order more than the sum of its lines' remaining (unordered) quantity.
        function validateRowMax(row) {
            var max = row.dataset.maxQuantity;
            var qtyField = row.querySelector('input[name="quantity"]');
            if (max === undefined) {
                setFieldError(qtyField, '');
                return true;
            }
            var qty = parseFloat(qtyField.value) || 0;
            if (qty > parseFloat(max)) {
                setFieldError(qtyField, 'Exceeds remaining orderable quantity (' + max + ') for this requisition line.');
                return false;
            }
            setFieldError(qtyField, '');
            return true;
        }

        document.getElementById('lines').addEventListener('change', function (e) {
            if (e.target.classList.contains('line-quantity')) {
                rescaleRowSources(e.target.closest('.line-row'));
                validateRowMax(e.target.closest('.line-row'));
            }
        });

        // Auto-fills PO lines from every selected requisition, merging same item+warehouse combos into one
        // editable row (prefilling only the still-unordered quantity) while keeping the per-requisition
        // breakdown for audit/display purposes.
        function applyRequisitionSelection(requisitionIds) {
            var lines = document.getElementById('lines');
            lines.innerHTML = '';
            var selectedRequisitions = (requisitionIds || []).map(function (id) { return requisitionData[id]; }).filter(Boolean);
            var merged = {};
            var order = [];
            (requisitionIds || []).forEach(function (requisitionId) {
                var requisition = requisitionData[requisitionId];
                if (!requisition) return;
                requisition.lines.forEach(function (line) {
                    var key = line.itemId + '|' + requisition.warehouseId;
                    if (!merged[key]) {
                        merged[key] = { itemId: line.itemId, warehouseId: requisition.warehouseId, quantity: 0, maxQuantity: 0, sources: [] };
                        order.push(key);
                    }
                    merged[key].quantity += line.remainingQuantity;
                    merged[key].maxQuantity += line.remainingQuantity;
                    merged[key].sources.push({ purchaseRequisitionId: Number(requisitionId), purchaseRequisitionLineId: line.lineId, quantity: line.remainingQuantity });
                });
            });
            if (order.length > 0) {
                order.forEach(function (key) { appendLine(merged[key]); });
            } else {
                appendLine(null);
            }
        }

        document.getElementById('addLine').addEventListener('click', function () {
            appendLine(null);
        });

        document.getElementById('lines').addEventListener('click', function (e) {
            var button = e.target.closest('.remove-line');
            if (!button) return;
            var lines = document.getElementById('lines');
            if (lines.children.length > 1) {
                button.closest('.line-row').remove();
            }
        });

        $('#orderForm').on('change input', 'select[required], input[required]', function () {
            if (this.checkValidity()) setFieldError(this, '');
        });

        document.getElementById('orderForm').addEventListener('submit', function (event) {
            var valid = true;
            this.querySelectorAll('[required]').forEach(function (field) {
                var isFieldValid = field.checkValidity();
                setFieldError(field, isFieldValid ? '' : field.dataset.requiredMessage);
                valid = valid && isFieldValid;
            });
            document.querySelectorAll('.line-row').forEach(function (row) {
                if (!validateRowMax(row)) valid = false;
            });
            if (!valid) {
                event.preventDefault();
                event.stopPropagation();
            }
        });
    </script>
}
