@model Sugentra.ERP.UI.Models.Procurement.PurchaseOrderResponse
@{
    ViewData["Title"] = "Purchase Order Detail";
    var currencies = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Currency>)ViewBag.Currencies;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-shopping-cart-2-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Procurement", Url.Action("Index", "Workspace", new { id = "Procurement" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Purchase Orders", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.OrderNumber, null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_DetailNavHeader.cshtml", breadcrumb, new ViewDataDictionary(ViewData) { {
"CurrentId", Model.Id }, { "EditRouteId", Model.Id }, { "CanEdit", Model.Status == "Draft" && User.HasPermission("PurchaseOrder_Edit") } })

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Purchase Order Detail</h5>
        <div class="d-flex gap-2">
            @if (Model.Status == "Draft" && User.HasPermission("PurchaseOrder_Approve"))
            {
                <form method="post" asp-action="Submit" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary"><i class="ri ri-check-double-line me-1"></i>Submit</button>
                </form>
            }
            @if (Model.Status == "Approved" && Model.LifecycleStatus is "Open" or "PartiallyReceived" && User.HasPermission("PurchaseOrder_Revise"))
            {
                <form method="post" asp-action="Revise" asp-route-id="@Model.Id" onsubmit="return confirm('Create a revision of this purchase order? The current order will be marked Superseded.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning"><i class="ri ri-file-copy-2-line me-1"></i>Revise</button>
                </form>
            }
            @if (Model.Status == "Approved" && Model.LifecycleStatus == "Open" && User.HasPermission("PurchaseOrder_Cancel"))
            {
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                    <i class="ri ri-close-circle-line me-1"></i>Cancel
                </button>
            }
            @if (Model.Status == "Approved" && Model.LifecycleStatus is "Open" or "PartiallyReceived" && User.HasPermission("PurchaseOrder_Close"))
            {
                <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#closeOrderModal">
                    <i class="ri ri-lock-line me-1"></i>Close
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="mb-5">
            <h6>Information</h6>
            <table class="table table-borderless table-hover detail-info-table">
                <tbody>
                    <tr>
                        <td class="fw-medium">Order Number</td>
                        <td class="fw-bold">@Model.OrderNumber</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Status</td>
                        <td>
                            <span class="badge bg-label-@StatusBadgeHelper.GetColor(Model.Status)">@(Model.Status == "WaitingApproval"
                                                                ? $"Waiting Approval - {Model.CurrentApprovalLevel}"
                                                                : Model.Status)</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Vendor</td>
                        <td>@(Model.VendorCode is not null ? $"{Model.VendorCode} - {Model.VendorName}" : Model.VendorName)</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Currency</td>
                        <td>@(currencies.FirstOrDefault(c => c.Id == Model.CurrencyId)?.Name)</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Payment Term</td>
                        <td>@(Model.PaymentTermDays.HasValue ? $"{Model.PaymentTermDays} days" : "-")</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Order Date</td>
                        <td>@Model.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Expected Delivery</td>
                        <td>@(Model.ExpectedDeliveryDate.HasValue ? Model.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) : "-")</td>
                    </tr>
                    @if (Model.RevisesPurchaseOrderId.HasValue)
                    {
                        <tr>
                            <td class="fw-medium">Revises</td>
                            <td><a asp-action="Detail" asp-route-id="@Model.RevisesPurchaseOrderId">@Model.RevisesOrderNumber</a></td>
                        </tr>
                    }
                    @if (Model.RevisedByPurchaseOrderId.HasValue)
                    {
                        <tr>
                            <td class="fw-medium">Revised By</td>
                            <td><a asp-action="Detail" asp-route-id="@Model.RevisedByPurchaseOrderId">@Model.RevisedByOrderNumber</a></td>
                        </tr>
                    }
                    @if (Model.SourceRequisitions.Count > 0)
                    {
                        <tr>
                            <td class="fw-medium">Source Requisition@(Model.SourceRequisitions.Count > 1 ? "s" : "")</td>
                            <td>
                                @{ var prShown = Math.Min(2, Model.SourceRequisitions.Count); }
                                @for (var i = 0; i < prShown; i++)
                                {
                                    var pr = Model.SourceRequisitions[i];
                                    <a asp-controller="PurchaseRequisitions" asp-action="Detail" asp-route-id="@pr.Id">@pr.RequisitionNumber</a>
                                    @(i < prShown - 1 ? ", " : "")
                                }
                                @(Model.SourceRequisitions.Count > 2 ? (object)new Microsoft.AspNetCore.Html.HtmlString(" <span class=\"text-muted\" data-bs-toggle=\"tooltip\" title=\"" + string.Join(", ", Model.SourceRequisitions.Select(r => r.RequisitionNumber)) + "\">...</span>") : "")
                            </td>
                        </tr>
                    }
                    <tr>
                        <td class="fw-medium">Notes</td>
                        <td>@Model.Notes</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mb-5">
            <h6>Lines</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th class="col-fit">No</th>
                            <th>Item</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount (%)</th>
                            <th class="text-end">Received Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var lineNumber = 0;
                        }
                        @foreach (var line in Model.Lines)
                        {
                            lineNumber++;
                            <tr>
                                <td>@lineNumber</td>
                                <td>
                                    @(line.ItemCode is not null ? $"{line.ItemCode} - {line.ItemName}" : line.ItemName)
                                    @if (line.Sources.Count > 0 && Model.SourceRequisitions.Count > 1)
                                    {
                                        <div class="mt-1">
                                            @foreach (var s in line.Sources)
                                            {
                                                <span class="badge bg-label-info me-1 mb-1" style="font-size: 0.7rem;">
                                                    @(s.PurchaseRequisitionId.HasValue ? $"{s.RequisitionNumber}: {s.Quantity:N2}" : $"Manual: {s.Quantity:N2}")
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-end">@line.Quantity.ToString("N4")</td>
                                <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@line.DiscountPercent.ToString("N2")</td>
                                <td class="text-end">@line.ReceivedQuantity.ToString("N4")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mb-5">
            <h6>Approval History</h6>
            @{
                var approvalHistory = (IReadOnlyList<Sugentra.ERP.UI.Models.Approvals.ApprovalHistoryEntry>)ViewBag.ApprovalHistory;
            }
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th class="col-fit">No</th>
                            <th>Level</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td class="fw-medium">Draft Created</td>
                            <td>@(Model.CreatedByName ?? "-")</td>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td><span class="badge bg-label-secondary">Draft</span></td>
                            <td>-</td>
                        </tr>
                        @if (approvalHistory.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-muted small">No further approval history for this document.</td>
                            </tr>
                        }
                        else
                        {
                            var historyNumber = 1;
                            @foreach (var entry in approvalHistory)
                            {
                                historyNumber++;
                                var badgeClass = entry.Status switch
                                {
                                    "Approved" => "info",
                                    "Rejected" => "danger",
                                    "Waiting" => "warning",
                                    "Submitted" => "primary",
                                    _ => "secondary"
                                };
                                <tr>
                                    <td>@historyNumber</td>
                                    <td class="fw-medium">@entry.LevelName</td>
                                    <td>@(entry.ApproverName ?? "-")</td>
                                    <td>@(entry.ActionedAt.HasValue ? entry.ActionedAt.Value.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "-")</td>
                                    <td><span class="badge bg-label-@badgeClass">@entry.Status</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(entry.Comment) ? "-" : entry.Comment)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="prDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Requisition Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="prDetailModalBody"></div>
        </div>
    </div>
</div>

@if (Model.Status == "Approved" && Model.LifecycleStatus == "Open" && User.HasPermission("PurchaseOrder_Cancel"))
{
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Cancel Purchase Order</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>This purchase order has no Goods Receipt yet and will be fully cancelled; any linked requisition quantity is released.</p>
                        <label class="form-label" for="cancelOrderReason">Reason</label>
                        <textarea class="form-control" id="cancelOrderReason" name="reason" rows="3" required></textarea>
                        <div class="text-danger small mt-1 d-none" id="cancelOrderReasonError">Reason is required.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-label-dark waves-effect btn-filter-action" data-bs-dismiss="modal">Back</button>
                        <button type="submit" class="btn btn-danger btn-filter-action">Cancel Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Status == "Approved" && Model.LifecycleStatus is "Open" or "PartiallyReceived" && User.HasPermission("PurchaseOrder_Close"))
{
    <div class="modal fade" id="closeOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Close" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Close Purchase Order</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>The un-fulfilled remainder of every line will be released back to the source requisition(s). Already-received quantities are not affected.</p>
                        <label class="form-label" for="closeOrderReason">Reason</label>
                        <textarea class="form-control" id="closeOrderReason" name="reason" rows="3" required></textarea>
                        <div class="text-danger small mt-1 d-none" id="closeOrderReasonError">Reason is required.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-label-dark waves-effect btn-filter-action" data-bs-dismiss="modal">Back</button>
                        <button type="submit" class="btn btn-dark btn-filter-action">Close Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var requisitionDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((IReadOnlyList<Sugentra.ERP.UI.Models.Procurement.PurchaseRequisitionResponse>)ViewBag.RequisitionDetails).ToDictionary(
                pr => pr.Id.ToString(),
                pr => new
                {
                    requisitionNumber = pr.RequisitionNumber,
                    requisitionDate = pr.RequisitionDate.ToString("yyyy-MM-dd"),
                    requesterName = pr.RequesterName,
                    notes = pr.Notes,
                    lines = pr.Lines.Select(l => new { itemCode = l.ItemCode, itemName = l.ItemName, quantity = l.Quantity, notes = l.Notes })
                })));

        function showPrDetailModal(requisitionId) {
            var pr = requisitionDetails[requisitionId];
            if (!pr) return;
            var linesHtml = pr.lines.map(function (l) {
                return '<tr><td>' + (l.itemCode ? l.itemCode + ' - ' + l.itemName : l.itemName) + '</td>'
                    + '<td class="text-end">' + l.quantity + '</td>'
                    + '<td>' + (l.notes || '') + '</td></tr>';
            }).join('');
            var html = '<div class="row g-2 mb-3">'
                + '<div class="col-md-6"><strong>Requisition No.</strong><div>' + pr.requisitionNumber + '</div></div>'
                + '<div class="col-md-6"><strong>Date</strong><div>' + pr.requisitionDate + '</div></div>'
                + '<div class="col-md-6"><strong>Requester</strong><div>' + (pr.requesterName || '-') + '</div></div>'
                + '<div class="col-md-6"><strong>Notes</strong><div>' + (pr.notes || '-') + '</div></div>'
                + '</div>'
                + '<table class="table table-sm"><thead><tr><th>Item</th><th class="text-end">Quantity</th><th>Notes</th></tr></thead>'
                + '<tbody>' + linesHtml + '</tbody></table>';
            document.getElementById('prDetailModalBody').innerHTML = html;
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('prDetailModal'));
            modal.show();
        }

        document.addEventListener('click', function (e) {
            var badge = e.target.closest('.pr-source-badge');
            if (!badge) return;
            showPrDetailModal(badge.dataset.requisitionId);
        });

        function wireReasonValidation(formSelector, textareaId, errorId) {
            var form = document.querySelector(formSelector);
            if (!form) return;
            form.addEventListener('submit', function (event) {
                var reason = document.getElementById(textareaId);
                var error = document.getElementById(errorId);
                if (!reason.value.trim()) {
                    event.preventDefault();
                    error.classList.remove('d-none');
                } else {
                    error.classList.add('d-none');
                }
            });
        }
        wireReasonValidation('#cancelOrderModal form', 'cancelOrderReason', 'cancelOrderReasonError');
        wireReasonValidation('#closeOrderModal form', 'closeOrderReason', 'closeOrderReasonError');
    </script>
}
