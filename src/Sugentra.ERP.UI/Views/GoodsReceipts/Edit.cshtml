@model Sugentra.ERP.UI.Models.Inventory.GoodsReceiptResponse
@{
    ViewData["Title"] = "Edit Goods Receipt";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var purchaseOrders = (IReadOnlyList<Sugentra.ERP.UI.Models.Procurement.PurchaseOrderResponse>)ViewBag.PurchaseOrders;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-truck-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Goods Receipts", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.ReceiptNumber, null)
    });
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form id="receiptForm" method="post" novalidate>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Receipt Number</label>
                <div class="col-md-4 col-sm-8"><input class="form-control form-control-sm" value="@Model.ReceiptNumber" readonly /></div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Status</label>
                <div class="col-md-4 col-sm-8 d-flex align-items-center">
                    <span class="badge bg-label-@StatusBadgeHelper.GetColor(Model.Status)">@Model.Status</span>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Warehouse</label>
                <div class="col-md-4 col-sm-8">
                    <select name="warehouseId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%" required data-required-message="Warehouse is required.">
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id" selected="@(w.Id == Model.WarehouseId ? "selected" : null)">@w.Code - @w.Name</option>
                        }
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Vendor Reference</label>
                <div class="col-md-4 col-sm-8"><input name="vendorReference" class="form-control form-control-sm" value="@Model.VendorReference" /></div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Purchase Order</label>
                <div class="col-md-4 col-sm-8">
                    <select name="purchaseOrderId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%">
                        <option value="">-- No Purchase Order --</option>
                        @foreach (var po in purchaseOrders)
                        {
                            <option value="@po.Id" selected="@(po.Id == Model.PurchaseOrderId ? "selected" : null)">@po.OrderNumber - @po.VendorName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Receipt Date</label>
                <div class="col-md-4 col-sm-8">
                    <div class="input-group input-group-sm receipt-date-group">
                        <input name="receiptDate" type="text"
                               class="form-control form-control-sm receipt-date-flatpickr"
                               autocomplete="off" value="@Model.ReceiptDate.ToString("yyyy-MM-dd HH:mm")"
                               required data-required-message="Receipt date is required." />
                        <span class="input-group-text receipt-date-toggle"><i class="ri ri-calendar-line"></i></span>
                    </div>
                    <div class="text-danger small line-error"></div>
                </div>
                </div>
                <div class="row g-2">
                    <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Notes</label>
                    <div class="col-md-4 col-sm-8"><textarea name="notes" class="form-control form-control-sm" rows="4">@Model.Notes</textarea>
                    </div>
                </div>

            <h6 class="mb-3">Lines</h6>
            <div class="row g-2 mb-1">
                <label class="col-md-2 form-label mb-0 small required-label">Batch</label>
                <label class="col-md-4 form-label mb-0 small">Item</label>
                <label class="col-md-3 form-label mb-0 small required-label">Quantity</label>
                <label class="col-md-3 form-label mb-0 small required-label">Unit Cost</label>
            </div>
            <div id="lines">
                @foreach (var line in Model.Lines)
                {
                    <div class="row g-2 mb-2 line-row">
                        <div class="col-md-2">
                            <div class="input-group input-group-sm">
                                <select name="batchId" class="selectpicker form-control form-control-sm gr-select batch-select"
                                        data-live-search="true" data-style="btn-default" data-width="100%" required
                                        data-required-message="Batch is required.">
                                    <option value="">-- Select Batch --</option>
                                    @foreach (var batch in batches)
                                    {
                                        <option value="@batch.Id" data-item-id="@batch.ItemId"
                                                selected="@(batch.Id == line.BatchId ? "selected" : null)">@batch.Code</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-primary new-batch-btn" data-bs-toggle="tooltip" title="New Batch">
                                    <i class="ri ri-add-line icon-14px"></i>
                                </button>
                            </div>
                            <div class="text-danger small line-error"></div>
                        </div>
                        <div class="col-md-4">
                            <select name="itemId" class="selectpicker form-control form-control-sm gr-select item-select"
                                    data-live-search="true" data-style="btn-default" data-width="100%" disabled>
                                <option value="">-- Select batch first --</option>
                                @foreach (var item in items)
                                {
                                    <option value="@item.Id" selected="@(item.Id == line.ItemId ? "selected" : null)">@item.Code - @item.Name</option>
                                }
                            </select>
                            <input type="hidden" name="itemId" class="item-hidden" value="@line.ItemId" />
                            <div class="text-danger small line-error item-error"></div>
                        </div>
                        <div class="col-md-3">
                            <input name="quantity" type="number" step="0.01" class="form-control form-control-sm"
                                   value="@line.Quantity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" required
                                   data-required-message="Quantity is required." />
                            <div class="text-danger small line-error"></div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm has-validation unit-cost-group">
                                <input name="unitCost" type="number" step="0.01" class="form-control form-control-sm"
                                       value="@line.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)" required
                                       data-required-message="Unit cost is required." />
                                <button type="button" class="btn btn-sm btn-outline-danger remove-line" data-bs-toggle="tooltip"
                                        title="Remove">
                                    <i class="ri ri-delete-bin-line icon-14px"></i>
                                </button>
                            </div>
                            <div class="text-danger small line-error"></div>
                        </div>
                    </div>
                }
            </div>
            <button type="button" id="addLine" class="btn btn-sm btn-outline-primary mb-4">+ Add Line</button>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
        <button type="submit" form="receiptForm" class="btn btn-primary btn-sm btn-filter-action">Save</button>
    </div>
</div>

<div class="modal fade" id="newBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">New Batch</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small required-label">Item</label>
                    <select class="selectpicker form-control form-control-sm" id="newBatchItemId" data-live-search="true"
                            data-style="btn-default" data-width="100%">
                        <option value="">-- Select Item --</option>
                        @foreach (var item in items)
                        {
                            <option value="@item.Id" data-code="@item.Code">@item.Code - @item.Name</option>
                        }
                    </select>
                    <div class="text-danger small" id="newBatchItemError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label small required-label">Code</label>
                    <input type="text" class="form-control form-control-sm" id="newBatchCode" readonly />
                    <div class="text-danger small" id="newBatchCodeError"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label small">Grade</label>
                    <input type="text" class="form-control form-control-sm" id="newBatchGrade" />
                </div>
                <div class="mb-3">
                    <label class="form-label small required-label">Received Date</label>
                    <input type="date" class="form-control form-control-sm" id="newBatchReceivedDate" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Legality Document Type</label>
                    <select class="form-select form-select-sm" id="newBatchLegalityType">
                        <option value="">-- None --</option>
                        <option value="SVLK">SVLK</option>
                        <option value="FSC">FSC</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small">Legality Document Number</label>
                    <input type="text" class="form-control form-control-sm" id="newBatchLegalityNumber" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Legality Document Url</label>
                    <input type="text" class="form-control form-control-sm" id="newBatchLegalityUrl" />
                </div>
                <div class="text-danger small" id="newBatchError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-label-dark" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="newBatchSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Self-heals against double-wrapping the same <select> (bootstrap-select always
        // wraps on init; calling it twice on one element without destroying the old
        // wrapper first creates a duplicated menu) — e.g. bfcache restores re-running this script.
        // Scoped to .gr-select, not .selectpicker: bootstrap-select strips the "selectpicker"
        // class from the element after its first init, so a clone of an already-initialized
        // row (see addLine below) would silently match nothing if we selected on that class.
        function initSelectPickers($scope) {
            $scope.find('select.gr-select').each(function () {
                var $select = $(this);
                if ($select.closest('.bootstrap-select').length) {
                    $select.selectpicker('destroy');
                }
                $select.selectpicker();
            });
        }

        // selectpicker('refresh') duplicates the rendered title text in this bootstrap-select build
        // (it re-scans options into an internal cache without clearing the previous entries first),
        // so re-render by destroying and re-initializing the widget instead.
        function rerenderSelectPicker($select) {
            $select.selectpicker('destroy');
            $select.selectpicker();
        }

        $(function () {
            initSelectPickers($(document));
            $('.receipt-date-flatpickr').each(function () {
                // append to body so the popup calendar doesn't shift the layout on focus
                var picker = flatpickr(this, { enableTime: true, dateFormat: 'Y-m-d H:i', time_24hr: true, allowInput: true, appendTo: document.body });
                $(this).closest('.receipt-date-group').find('.receipt-date-toggle').on('click', function () {
                    picker.open();
                });
            });
        });

        // Shows the small `data-required-message` text under a required field, or clears it when valid.
        function setFieldError(field, message) {
            var errorEl = field.closest('.col-md-2, .col-md-3, .col-md-4, .col-sm-8')?.querySelector('.line-error');
            if (errorEl) errorEl.textContent = message || '';
        }

        function syncItemFromBatch(row) {
            var batchSelect = row.querySelector('select.batch-select');
            var itemSelect = row.querySelector('select.item-select');
            var itemHidden = row.querySelector('.item-hidden');
            var selectedOption = batchSelect.options[batchSelect.selectedIndex];
            var itemId = selectedOption ? (selectedOption.getAttribute('data-item-id') || '') : '';
            $(itemSelect).val(itemId);
            rerenderSelectPicker($(itemSelect));
            itemHidden.value = itemId;
            if (itemId) {
                var itemErrorEl = row.querySelector('.item-error');
                if (itemErrorEl) itemErrorEl.textContent = '';
            }
        }

        // A batch already picked in another line can't be picked again (one batch = one line).
        // Rows auto-filled from a PO (marked with data-po-item) are locked to that item, so
        // only batches for that same item are offered - the rest would silently break the Item column.
        function refreshBatchOptions() {
            var batchSelects = document.querySelectorAll('select.batch-select');
            var usedValues = Array.from(batchSelects).map(function (s) { return s.value; }).filter(Boolean);
            batchSelects.forEach(function (select) {
                var row = select.closest('.line-row');
                var lockedItemId = row.dataset.poItem || '';
                Array.from(select.options).forEach(function (option) {
                    if (!option.value) return;
                    var usedElsewhere = usedValues.includes(option.value) && option.value !== select.value;
                    var wrongItem = lockedItemId && option.getAttribute('data-item-id') !== lockedItemId;
                    option.disabled = usedElsewhere || wrongItem;
                });
                rerenderSelectPicker($(select));
            });
        }

        document.getElementById('addLine').addEventListener('click', function () {
            var lines = document.getElementById('lines');
            var clone = lines.firstElementChild.cloneNode(true);
            // cloneNode copies the already-rendered bootstrap-select wrapper markup (not the jQuery
            // plugin instance) and the ids bootstrap-select assigned; drop both before re-initializing,
            // since a duplicate id makes the plugin cross-wire the toggle rendering between rows.
            clone.querySelectorAll('.bootstrap-select').forEach(function (wrapper) {
                wrapper.replaceWith(wrapper.querySelector('select'));
            });
            clone.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
            clone.querySelectorAll('input:not(.item-hidden)').forEach(function (i) { i.value = ''; });
            clone.querySelector('.item-hidden').value = '';
            clone.querySelector('select.batch-select').value = '';
            clone.querySelector('select.item-select').value = '';
            lines.appendChild(clone);
            initSelectPickers($(clone));
            refreshBatchOptions();
        });

        $('#lines').on('change', '.batch-select', function (e) {
            syncItemFromBatch(e.target.closest('.line-row'));
            refreshBatchOptions();
        });

        document.getElementById('lines').addEventListener('click', function (e) {
            var btn = e.target.closest('.remove-line');
            if (!btn) return;
            var lines = document.getElementById('lines');
            var row = btn.closest('.line-row');
            if (lines.children.length > 1) {
                row.remove();
            } else {
                row.querySelectorAll('input:not(.item-hidden)').forEach(function (i) { i.value = ''; });
                row.querySelector('.item-hidden').value = '';
                $(row).find('select.batch-select, select.item-select').val('');
                rerenderSelectPicker($(row).find('select.batch-select, select.item-select'));
                row.querySelectorAll('.line-error').forEach(function (el) { el.textContent = ''; });
            }
            refreshBatchOptions();
        });

        refreshBatchOptions();

        // Clears a required field's message as soon as it becomes valid, so it works for
        // rows added later by #addLine (delegated on the form, not bound per-element).
        $('#receiptForm').on('change input', 'select.batch-select, select[name="warehouseId"], input[required]', function () {
            if (this.checkValidity()) setFieldError(this, '');
        });

        document.getElementById('receiptForm').addEventListener('submit', function (event) {
            var valid = true;
            this.querySelectorAll('[required]').forEach(function (field) {
                var isFieldValid = field.checkValidity();
                setFieldError(field, isFieldValid ? '' : field.dataset.requiredMessage);
                valid = valid && isFieldValid;
            });
            document.querySelectorAll('.item-hidden').forEach(function (hidden) {
                var isValid = !!hidden.value;
                var itemErrorEl = hidden.closest('.line-row').querySelector('.item-error');
                if (itemErrorEl) itemErrorEl.textContent = isValid ? '' : 'Item is required: select a batch first.';
                valid = valid && isValid;
            });
            if (!valid) { event.preventDefault(); event.stopPropagation(); }
        });

        // ---- Create Batch inline, without leaving the Goods Receipt form ----
        var newBatchRow = null;
        var newBatchModal = new bootstrap.Modal(document.getElementById('newBatchModal'));

        // Code is a lot identifier, not something users need to invent - derive it from the
        // item code + a timestamp so it's unique without a round-trip to the server.
        function generateBatchCode(itemSelect) {
            var option = itemSelect.options[itemSelect.selectedIndex];
            var itemCode = option ? (option.getAttribute('data-code') || 'BATCH') : 'BATCH';
            var stamp = new Date().toISOString().replace(/[-:T.]/g, '').slice(0, 14);
            $('#newBatchCode').val(itemCode + '-' + stamp);
        }

        $('#lines').on('click', '.new-batch-btn', function () {
            newBatchRow = $(this).closest('.line-row')[0];
            var lockedItemId = newBatchRow.dataset.poItem || '';
            var $itemSelect = $('#newBatchItemId');
            $itemSelect.val(lockedItemId).prop('disabled', !!lockedItemId);
            rerenderSelectPicker($itemSelect);
            $('#newBatchGrade, #newBatchLegalityNumber, #newBatchLegalityUrl').val('');
            $('#newBatchLegalityType').val('');
            $('#newBatchReceivedDate').val(new Date().toISOString().slice(0, 10));
            $('#newBatchItemError, #newBatchCodeError, #newBatchError').text('');
            generateBatchCode($itemSelect[0]);
            newBatchModal.show();
        });

        $('#newBatchItemId').on('change', function () {
            generateBatchCode(this);
        });

        $('#newBatchSave').on('click', function () {
            var itemId = $('#newBatchItemId').val();
            var code = $('#newBatchCode').val().trim();
            var receivedDate = $('#newBatchReceivedDate').val();
            var warehouseId = $('select[name="warehouseId"]').val();

            var valid = true;
            if (!itemId) { $('#newBatchItemError').text('Item is required.'); valid = false; } else { $('#newBatchItemError').text(''); }
            if (!code) { $('#newBatchCodeError').text('Code is required.'); valid = false; } else { $('#newBatchCodeError').text(''); }
            if (!warehouseId) { $('#newBatchError').text('Select a Warehouse first.'); valid = false; }
            if (!valid) return;

            fetch('@Url.Action("CreateBatchInline")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    itemId: Number(itemId),
                    warehouseId: Number(warehouseId),
                    code: code,
                    grade: $('#newBatchGrade').val() || null,
                    receivedDate: receivedDate,
                    legalityDocumentType: $('#newBatchLegalityType').val() || null,
                    legalityDocumentNumber: $('#newBatchLegalityNumber').val() || null,
                    legalityDocumentUrl: $('#newBatchLegalityUrl').val() || null
                })
            })
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    if (!result.success) {
                        $('#newBatchError').text(result.message || 'Failed to create batch.');
                        return;
                    }
                    var $batchSelect = $(newBatchRow).find('select.batch-select');
                    $batchSelect.append(new Option(result.code, result.id, false, false));
                    $batchSelect.find('option[value="' + result.id + '"]').attr('data-item-id', String(result.itemId));
                    $batchSelect.val(result.id);
                    rerenderSelectPicker($batchSelect);
                    syncItemFromBatch(newBatchRow);
                    refreshBatchOptions();
                    newBatchModal.hide();
                })
                .catch(function () { $('#newBatchError').text('Failed to create batch.'); });
        });
    </script>
}
