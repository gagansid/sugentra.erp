@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Settings.Holiday>
@{
    ViewData["Title"] = "Holidays";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-settings-3-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Settings", Url.Action("Index", "Workspace", new { id = "Settings" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Holidays", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Holidays</h5>
        @if (User.HasPermission("Holiday_Create"))
        {
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add Data</a>
        }
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 mb-2">
        @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        <form method="get" id="holidaysFilterForm" class="d-flex align-items-center gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   style="width: 250px;" value="@ViewBag.Keyword" placeholder="Search.." />
            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Reset</a>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Date</th>
                    <th>Name</th>
                    <th class="text-center" style="width: 110px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center">No holidays configured.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var holiday in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@holiday.Date.ToString("dd MMM yyyy")</td>
                            <td>@holiday.Name</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    @if (User.HasPermission("Holiday_Edit"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@holiday.Id" class="btn btn-icon btn-text-secondary"
                                           data-bs-toggle="tooltip" title="Edit"><i class="ri ri-edit-line icon-14px"></i></a>
                                    }
                                    @if (User.HasPermission("Holiday_Delete"))
                                    {
                                        <button type="button" class="btn btn-icon btn-text-danger" data-bs-toggle="tooltip"
                                                title="Delete" onclick="confirmDelete(this)" data-name="@holiday.Name"
                                                data-delete-url="@Url.Action("Delete", new { id = holiday.Id })"><i
                                            class="ri ri-delete-bin-line icon-14px"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>

@await Html.PartialAsync("_DeleteConfirmModal", "Holiday")
