@model Sugentra.ERP.UI.Models.Inventory.Batch
@{
    ViewData["Title"] = "Batch Detail";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-archive-2-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Batches", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.Code, null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Batch @Model.Code</h5>
        @if (User.HasPermission("Batch_Edit"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i
                class="ri ri-edit-line me-1"></i>Edit</a>
            }
        </div>
        <div class="card-body">
            <table class="table table-borderless table-hover mb-0 detail-info-table">
                <tbody>
                    <tr>
                        <td>Code</td>
                        <td class="fw-bold">@Model.Code</td>
                    </tr>
                    <tr>
                        <td>Item</td>
                        <td>@(items.FirstOrDefault(i => i.Id == Model.ItemId)?.Name)</td>
                    </tr>
                    <tr>
                        <td>Grade</td>
                        <td>@Model.Grade</td>
                    </tr>
                    <tr>
                        <td>Warehouse</td>
                        <td>@(warehouses.FirstOrDefault(w => w.Id == Model.WarehouseId)?.Name)</td>
                    </tr>
                    <tr>
                        <td>Received Date</td>
                        <td>@Model.ReceivedDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td>Legality Document</td>
                        <td>@Model.LegalityDocumentType @Model.LegalityDocumentNumber</td>
                    </tr>
                    <tr>
                        <td>Source Reference</td>
                        <td>@Model.SourceReference</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
