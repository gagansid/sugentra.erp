@model Sugentra.ERP.UI.Models.Settings.Module
@{
    ViewData["Title"] = "Module";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-settings-3-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Settings", Url.Action("Index", "Workspace", new { id = "Settings" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Modules", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Edit", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row mb-3">
                        <label asp-for="Code" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Code" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Name" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Name" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Route" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="Route" class="form-control form-control-sm" placeholder="/ModuleName" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Icon" class="col-sm-3 col-form-label col-form-label-sm">Icon</label>
                        <div class="col-sm-9">
                            <input asp-for="Icon" class="form-control form-control-sm"
                                   placeholder="e.g. ri-database-2-line" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="ImageUrl" class="col-sm-3 col-form-label col-form-label-sm">Image URL</label>
                        <div class="col-sm-9">
                            <input asp-for="ImageUrl" class="form-control form-control-sm"
                                   placeholder="used instead of icon, optional" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="SortOrder" class="col-sm-3 col-form-label col-form-label-sm"></label>
                        <div class="col-sm-9">
                            <input asp-for="SortOrder" type="number" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Color" class="col-sm-3 col-form-label col-form-label-sm">Icon Color</label>
                        <div class="col-sm-9">
                            <input asp-for="Color" type="color" class="form-control form-control-sm form-control-color"
                                   value="@(Model.Color ?? "#696cff")" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="ColorOpacity" class="col-sm-3 col-form-label col-form-label-sm">Icon
                            Opacity</label>
                            <div class="col-sm-9">
                                <input asp-for="ColorOpacity" type="number" step="0.05" min="0" max="1"
                                       class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="BackgroundColor" class="col-sm-3 col-form-label col-form-label-sm">Box
                                Background Color</label>
                                <div class="col-sm-9">
                                    <input asp-for="BackgroundColor" type="color"
                                           class="form-control form-control-sm form-control-color"
                                           value="@(Model.BackgroundColor ?? "#696cff")" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label asp-for="BackgroundOpacity" class="col-sm-3 col-form-label col-form-label-sm">Box
                                    Background Opacity</label>
                                    <div class="col-sm-9">
                                        <input asp-for="BackgroundOpacity" type="number" step="0.05" min="0" max="1"
                                               class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label asp-for="TextColor" class="col-sm-3 col-form-label col-form-label-sm">Text Color</label>
                                    <div class="col-sm-9">
                                        <input asp-for="TextColor" type="color"
                                               class="form-control form-control-sm form-control-color"
                                               value="@(Model.TextColor ?? "#566a7f")" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label col-form-label-sm"></label>
                                    <div class="col-sm-9">
                                        <div class="form-check form-switch">
                                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                            <label asp-for="IsActive" class="form-check-label">Active</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 d-flex justify-content-end gap-2">
                                    <a asp-action="Index"
                                       class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
                                    <button type="submit" class="btn btn-primary btn-sm btn-filter-action">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
