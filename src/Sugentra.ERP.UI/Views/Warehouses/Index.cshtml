@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Settings.Warehouse>
@{
    ViewData["Title"] = "Warehouses";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-settings-3-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Settings", Url.Action("Index", "Workspace", new { id = "Settings" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Warehouses", null)
    });
    var hasAdvancedFilter = !string.IsNullOrEmpty(ViewBag.WarehouseType as string) || ViewBag.IsActive != null;
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Warehouses</h5>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 mb-2">
        @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        <form method="get" id="warehousesFilterForm" class="d-flex align-items-center gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   style="width: 250px;" value="@ViewBag.Keyword" placeholder="Search..." />
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-primary position-relative"
                        id="warehousesFilterDropdown" data-bs-toggle="dropdown"
                        data-bs-auto-close="outside" aria-expanded="@(hasAdvancedFilter ? "true" : "false")">
                    <i class="ri ri-filter-3-line me-1"></i>Filter
                    @if (hasAdvancedFilter)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                            <span class="visually-hidden">Filter active</span>
                        </span>
                    }
                </button>
                <div class="dropdown-menu dropdown-menu-end w-px-350 p-0" aria-labelledby="warehousesFilterDropdown">
                    <div class="card mb-0 shadow-none">
                        <div class="card-header py-2">
                            <h6 class="mb-3">Filter</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-12 mb-2">
                                    <label class="form-label mb-1 small">Type</label>
                                    <select name="warehouseType" class="form-select form-select-sm">
                                        <option value="">All Types</option>
                                        @foreach (var type in new[] { "Main", "Quarantine", "Vendor" })
                                        {
                                            <option value="@type" selected="@(type.Equals(ViewBag.WarehouseType) ? "selected" : null)">@type</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 mb-2">
                                    <label class="form-label mb-1 small">Status</label>
                                    <select name="isActive" class="form-select form-select-sm">
                                        <option value="">All Status</option>
                                        <option value="true" selected="@(true.Equals(ViewBag.IsActive) ? "selected" : null)">Active</option>
                                        <option value="false" selected="@(false.Equals(ViewBag.IsActive) ? "selected" : null)">Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Clear</a>
                            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
            @if (User.HasPermission("Warehouse_Create"))
            {
                <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add New</a>
            }
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>City</th>
                    <th class="col-fit">Type</th>
                    <th class="col-fit">Status</th>
                    <th class="text-center" style="width: 110px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center">No warehouses configured.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var warehouse in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@warehouse.Code</td>
                            <td>@warehouse.Name</td>
                            <td>@warehouse.City</td>
                            <td>
                                <span class="badge bg-label-@(warehouse.WarehouseType switch
                                                               {
                                                                   "Quarantine" => "warning",
                                                                   "Vendor" => "info",
                                                                   _ => "secondary"
                                                               })">@warehouse.WarehouseType</span>
                            </td>
                            <td>
                                @if (warehouse.IsActive)
                                {
                                    <span class="badge bg-label-primary">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (User.HasPermission("Warehouse_Edit") || User.HasPermission("Warehouse_Delete"))
                                {
                                    <div class="d-flex gap-2 justify-content-center">
                                        @if (User.HasPermission("Warehouse_Edit"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@warehouse.Id" class="btn btn-icon btn-text-secondary"
                                               data-bs-toggle="tooltip" title="Edit"><i class="ri ri-edit-line icon-14px"></i></a>
                                        }
                                        @if (User.HasPermission("Warehouse_Delete"))
                                        {
                                            <button type="button" class="btn btn-icon btn-text-danger" data-bs-toggle="tooltip"
                                                    title="Delete" onclick="confirmDelete(this)"
                                                    data-name="@warehouse.Name"
                                                    data-delete-url="@Url.Action("Delete", new { id = warehouse.Id })"><i
                                                class="ri ri-delete-bin-line icon-14px"></i></button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>

@await Html.PartialAsync("_DeleteConfirmModal", "Warehouse")

