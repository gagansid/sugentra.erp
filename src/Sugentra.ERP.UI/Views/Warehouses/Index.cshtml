@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Settings.Warehouse>
@{
    ViewData["Title"] = "Warehouses";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-settings-3-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Settings", Url.Action("Index", "Workspace", new { id = "Settings" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Warehouses", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<style>
    .warehouses-filter-form .filter-field {
        width: 100%;
    }

    .warehouses-filter-form-actions .btn {
        width: 80px;
        max-width: 80px;
    }

    @@media (min-width: 576px) {
        .warehouses-filter-form .filter-keyword {
            width: 220px;
        }

        .warehouses-filter-form .filter-status {
            width: 150px;
        }
    }
</style>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Warehouses</h5>
        @if (User.HasPermission("Warehouse_Create"))
        {
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add Data</a>
        }
    </div>
    <div class="pt-4 mb-2"
         style="padding-left: var(--bs-card-cap-padding-x); padding-right: var(--bs-card-cap-padding-x);">
        <form method="get" id="warehousesFilterForm" class="warehouses-filter-form">
            <div class="d-flex flex-wrap align-items-center gap-2 justify-content-end w-100 mb-2">
                <input type="text" name="keyword" class="form-control form-control-sm filter-field filter-keyword"
                       value="@ViewBag.Keyword" placeholder="Search..." />
                <select name="isActive" class="form-select form-select-sm filter-field filter-status">
                    <option value="">All Status</option>
                    <option value="true" selected="@(true.Equals(ViewBag.IsActive) ? "selected" : null)">Active</option>
                    <option value="false" selected="@(false.Equals(ViewBag.IsActive) ? "selected" : null)">Inactive
                    </option>
                </select>
            </div>
        </form>
        <div class="d-flex flex-row justify-content-between align-items-center gap-2">
            <div class="flex-shrink-0">
                @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
            </div>
            <div class="d-flex gap-2 warehouses-filter-form-actions">
                <button type="submit" form="warehousesFilterForm"
                        class="btn btn-sm btn-primary btn-filter-action">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Reset</a>
            </div>
        </div>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Type</th>
                    <th class="col-fit">Status</th>
                    <th class="text-center" style="width: 110px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center">No warehouses configured.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var warehouse in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@warehouse.Code</td>
                            <td>@warehouse.Name</td>
                            <td>@warehouse.City</td>
                            <td>@warehouse.WarehouseType</td>
                            <td>
                                @if (warehouse.IsActive)
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (User.HasPermission("Warehouse_Edit") || User.HasPermission("Warehouse_Delete"))
                                {
                                    <div class="d-flex gap-2 justify-content-center">
                                        @if (User.HasPermission("Warehouse_Edit"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@warehouse.Id" class="btn btn-icon btn-text-secondary"
                                               data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i
                                                class="ri ri-edit-line icon-14px"></i></a>
                                            }
                                            @if (User.HasPermission("Warehouse_Delete"))
                                            {
                                                <button type="button" class="btn btn-icon btn-text-danger" data-bs-toggle="tooltip"
                                                        data-bs-placement="top" title="Delete" onclick="showDeleteWarehouseModal(this)"
                                                        data-name="@warehouse.Name"
                                                        data-delete-url="@Url.Action("Delete", new { id = warehouse.Id })"><i
                                                    class="ri ri-delete-bin-line icon-14px"></i></button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        </div>

        <div class="modal fade" id="deleteWarehouseModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="deleteWarehouseForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Delete Warehouse</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">Are you sure you want to delete <strong id="deleteWarehouseName"></strong>?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-label-dark waves-effect btn-filter-action"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger btn-filter-action">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            function showDeleteWarehouseModal(button) {
                document.getElementById('deleteWarehouseName').textContent = button.getAttribute('data-name');
                document.getElementById('deleteWarehouseForm').action = button.getAttribute('data-delete-url');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteWarehouseModal')).show();
            }
        </script>
