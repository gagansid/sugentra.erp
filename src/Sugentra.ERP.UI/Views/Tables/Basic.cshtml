@{
    ViewData["Title"] = "Tables";
}

<h4 class="mb-1">Table Styles</h4>
<p class="mb-6">Plain Bootstrap table variants used across the app (no DataTables JS) — reference sample data only.</p>

<!-- Table Basic -->
<div class="card mb-6">
    <h5 class="card-header">Table Basic</h5>
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                <tr>
                    <td>ITM-001</td>
                    <td>Raw Rattan Core</td>
                    <td>Raw Material</td>
                    <td><span class="badge bg-label-success">Active</span></td>
                    <td><a href="javascript:void(0);" class="btn btn-sm btn-icon btn-text-secondary"><i
                        class="ri ri-edit-line"></i></a></td>
                    </tr>
                    <tr>
                        <td>ITM-002</td>
                        <td>Woven Rattan Panel</td>
                        <td>Semi Finished</td>
                        <td><span class="badge bg-label-info">Scheduled</span></td>
                        <td><a href="javascript:void(0);" class="btn btn-sm btn-icon btn-text-secondary"><i
                            class="ri ri-edit-line"></i></a></td>
                        </tr>
                        <tr>
                            <td>ITM-003</td>
                            <td>Rattan Lounge Chair</td>
                            <td>Finished Good</td>
                            <td><span class="badge bg-label-secondary">Inactive</span></td>
                            <td><a href="javascript:void(0);" class="btn btn-sm btn-icon btn-text-secondary"><i
                                class="ri ri-edit-line"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
