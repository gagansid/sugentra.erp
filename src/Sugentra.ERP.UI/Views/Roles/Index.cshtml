@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Identity.RoleListItemDto>
@{
    ViewData["Title"] = "Roles";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-shield-user-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Identity & Access", Url.Action("Index", "Workspace", new { id =
"Identity" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Roles", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Roles</h5>
        @if (User.HasPermission("Role_Create"))
        {
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="ri ri-add-line me-1"></i>Add Role</a>
        }
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pe-4">
        <div class="w-25">
            @await Html.PartialAsync(partialViewName: "_ShowEntries",
            Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="text" name="name" class="form-control form-control-sm" style="max-width: 160px;"
                   value="@ViewBag.Name" placeholder="Name" />
            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Reset</a>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>IsActive</th>
                    <th class="text-center" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @{
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                }
                @foreach (var role in Model.Items)
                {
                    rowNo++;
                    <tr>
                        <td class="text-center">@rowNo</td>
                        <td>@role.Name</td>
                        <td>@role.Description</td>
                        <td>
                            @if (role.IsActive)
                            {
                                <span class="badge bg-label-primary">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-center">
                                @if (User.HasPermission("Permission_Assign"))
                                {
                                    <a asp-action="Permissions" asp-route-id="@role.Id" asp-route-name="@role.Name"
                                       class="btn btn-icon btn-text-secondary" data-bs-toggle="tooltip" data-bs-placement="top"
                                       title="Permissions"><i class="ri ri-key-2-line icon-14px"></i></a>
                                }
                                @if (User.HasPermission("Role_Update"))
                                {
                                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-icon btn-text-secondary"
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i
                                        class="ri ri-edit-line icon-14px"></i></a>
                                    }
                                    @if (User.HasPermission("Role_Delete"))
                                    {
                                        <button type="button" class="btn btn-icon btn-text-danger" data-bs-toggle="tooltip"
                                                data-bs-placement="top" title="Delete" onclick="showDeleteRoleModal(this)"
                                                data-role-name="@role.Name"
                                                data-delete-url="@Url.Action("Delete", new { id = role.Id })"><i
                                            class="ri ri-delete-bin-line icon-14px"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync(partialViewName: "_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        </div>

        <div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="deleteRoleForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Delete Role</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete role <strong id="deleteRoleName"></strong>? This action cannot
                                be undone.</p>
                                <label class="form-label">Type <strong>delete</strong> to confirm</label>
                                <input type="text" id="deleteRoleConfirmInput" class="form-control" autocomplete="off" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-label-dark waves-effect btn-filter-action"
                                        data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" id="deleteRoleConfirmBtn" class="btn btn-danger btn-filter-action"
                                        disabled>Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                function showDeleteRoleModal(button) {
                    document.getElementById('deleteRoleName').textContent = button.getAttribute('data-role-name');
                    document.getElementById('deleteRoleForm').action = button.getAttribute('data-delete-url');
                    var input = document.getElementById('deleteRoleConfirmInput');
                    input.value = '';
                    document.getElementById('deleteRoleConfirmBtn').disabled = true;
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteRoleModal')).show();
                }

                document.getElementById('deleteRoleConfirmInput').addEventListener('input', function () {
                    document.getElementById('deleteRoleConfirmBtn').disabled = this.value.trim().toLowerCase() !== 'delete';
                });
            </script>
