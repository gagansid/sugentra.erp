@model Sugentra.ERP.UI.Models.Inventory.StockOpnameResponse
@{
    ViewData["Title"] = "Stock Opname Detail";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-clipboard-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Stock Opnames", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.OpnameNumber, null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            Stock Opname @Model.OpnameNumber
            <span class="badge bg-label-@(Model.Status switch
                                           {
                                               "Draft" => "secondary",
                                               "Submitted" => "info",
                                               "Approved" => "success",
                                               _ => "secondary"
                                           }) ms-2">@Model.Status</span>
        </h5>
        <div class="d-flex gap-2">
            @if (Model.Status == "Draft" && User.HasPermission("StockOpname_Edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-label-dark"><i
                    class="ri ri-edit-line me-1"></i>Edit</a>
                    <form method="post" asp-action="Submit" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary"><i
                            class="ri ri-send-plane-line me-1"></i>Submit</button>
                        </form>
                    }
                    @if (Model.Status == "Submitted" && User.HasPermission("StockOpname_Edit"))
                    {
                        <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary"><i
                                class="ri ri-check-double-line me-1"></i>Approve</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-hover mb-0 detail-info-table">
                        <tbody>
                            <tr>
                                <td>Warehouse</td>
                                <td class="fw-bold">@(warehouses.FirstOrDefault(w => w.Id == Model.WarehouseId)?.Name)</td>
                            </tr>
                            <tr>
                                <td>Opname Date</td>
                                <td>@Model.OpnameDate.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td>Notes</td>
                                <td>@Model.Notes</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lines</h5>
                </div>
                <div class="table-responsive text-nowrap">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th class="col-fit">No</th>
                                <th>Item</th>
                                <th>Batch</th>
                                <th class="text-end">System Qty</th>
                                <th class="text-end">Counted Qty</th>
                                <th class="text-end">Variance</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @{
                                var lineNumber = 0;
                            }
                            @foreach (var line in Model.Lines)
                            {
                                lineNumber++;
                                <tr>
                                    <td class="text-center">@lineNumber</td>
                                    <td>@(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name)</td>
                                    <td>@(batches.FirstOrDefault(b => b.Id == line.BatchId)?.Code)</td>
                                    <td class="text-end">@line.SystemQuantity.ToString("N4")</td>
                                    <td class="text-end">@line.CountedQuantity.ToString("N4")</td>
                                    <td class="text-end @(line.VarianceQuantity != 0 ? "text-danger" : "")">
                                        @line.VarianceQuantity.ToString("N4")</td>
                                    <td>@line.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
