@model Sugentra.ERP.UI.Models.Inventory.StockOpnameResponse
@{
    ViewData["Title"] = "Stock Opname Detail";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var approvalHistory = (IReadOnlyList<Sugentra.ERP.UI.Models.Approvals.ApprovalHistoryEntry>)(ViewBag.ApprovalHistory ?? Array.Empty<Sugentra.ERP.UI.Models.Approvals.ApprovalHistoryEntry>());
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-clipboard-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Stock Opnames", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.OpnameNumber, null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_DetailNavHeader.cshtml", breadcrumb, new ViewDataDictionary(ViewData) { {
"CurrentId", Model.Id }, { "EditRouteId", Model.Id }, { "CanEdit", Model.Status == "Draft" && User.HasPermission("StockOpname_Edit") } })

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Stock Opname Detail</h5>
        <div class="d-flex gap-2">
            @if (Model.Status == "Draft" && User.HasPermission("StockOpname_Edit"))
            {
                <form method="post" asp-action="Post" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary"><i
                        class="ri ri-check-double-line me-1"></i>Post</button>
                </form>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="mb-5">
            <h6>Information</h6>
            <table class="table table-borderless table-hover detail-info-table">
                <tbody>
                    <tr>
                        <td class="fw-medium">Opname Number</td>
                        <td class="fw-bold">@Model.OpnameNumber</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Status</td>
                        <td>
                            <span class="badge bg-label-@(Model.Status switch
                                                        {
                                                            "Draft" => "secondary",
                                                            "WaitingApproval" => "warning",
                                                            "Completed" => "primary",
                                                            _ => "secondary"
                                                        })">@(Model.Status == "WaitingApproval"
                                                                ? $"Waiting Approval - {Model.CurrentApprovalLevel}"
                                                                : Model.Status)</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Warehouse</td>
                        <td>@(warehouses.FirstOrDefault(w => w.Id == Model.WarehouseId)?.Name)</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Opname Date</td>
                        <td>@Model.OpnameDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">Notes</td>
                        <td>@Model.Notes</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mb-5">
            <h6>Lines</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th class="col-fit">No</th>
                            <th>Item</th>
                            <th>Batch</th>
                            <th class="text-end">System Qty</th>
                            <th class="text-end">Counted Qty</th>
                            <th class="text-end">Variance</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var lineNumber = 0;
                        }
                        @foreach (var line in Model.Lines)
                        {
                            lineNumber++;
                            <tr>
                                <td>@lineNumber</td>
                                <td>@(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name)</td>
                                <td>@(batches.FirstOrDefault(b => b.Id == line.BatchId)?.Code)</td>
                                <td class="text-end">@line.SystemQuantity.ToString("N4")</td>
                                <td class="text-end">@line.CountedQuantity.ToString("N4")</td>
                                <td class="text-end @(line.VarianceQuantity != 0 ? "text-danger" : "")">
                                    @line.VarianceQuantity.ToString("N4")</td>
                                <td>@line.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mb-5">
            <h6>Approval History</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th class="col-fit">No</th>
                            <th>Level</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td class="fw-medium">Draft Created</td>
                            <td>-</td>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td><span class="badge bg-label-secondary">Draft</span></td>
                            <td>-</td>
                        </tr>
                        @if (approvalHistory.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-muted small">No further approval history for this document.</td>
                            </tr>
                        }
                        else
                        {
                            var historyNumber = 1;
                            @foreach (var entry in approvalHistory)
                            {
                                historyNumber++;
                                var badgeClass = entry.Status switch
                                {
                                    "Approved" => "info",
                                    "Rejected" => "danger",
                                    "Waiting" => "warning",
                                    _ => "secondary"
                                };
                                <tr>
                                    <td>@historyNumber</td>
                                    <td class="fw-medium">@entry.LevelName</td>
                                    <td>@(entry.ApproverName ?? "-")</td>
                                    <td>@(entry.ActionedAt.HasValue ? entry.ActionedAt.Value.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "-")</td>
                                    <td><span class="badge bg-label-@badgeClass">@entry.Status</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(entry.Comment) ? "-" : entry.Comment)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
