@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Approvals.ApprovalInboxItem>
@inject Sugentra.ERP.UI.Services.Settings.ModuleIconLookupService ModuleIconLookup
@{
    ViewData["Title"] = "My Approvals";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel(await ModuleIconLookup.GetIconAsync("Approvals"), new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Approvals", Url.Action("Index", "Workspace", new { id = "Approvals" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("My Approvals", null)
    });
    var approverTypeOptions = (ViewData["ApproverTypeOptions"] as IEnumerable<dynamic>) ?? [];
    var hasAdvancedFilter = ViewBag.ApproverType != null;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">My Approvals</h5>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 mb-2">
        @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        <form method="get" id="myApprovalsFilterForm" class="d-flex align-items-center gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   style="width: 250px;" value="@ViewBag.Keyword" placeholder="Search.." />
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-primary position-relative"
                        id="myApprovalsFilterDropdown" data-bs-toggle="dropdown"
                        data-bs-auto-close="outside" aria-expanded="@(hasAdvancedFilter ? "true" : "false")">
                    <i class="ri ri-filter-3-line me-1"></i>Filter
                    @if (hasAdvancedFilter)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                            <span class="visually-hidden">Filter active</span>
                        </span>
                    }
                </button>
                <div class="dropdown-menu dropdown-menu-end w-px-350 p-0" aria-labelledby="myApprovalsFilterDropdown">
                    <div class="card mb-0 shadow-none">
                        <div class="card-header py-2">
                            <h6 class="mb-3">Filter</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-12 mb-2">
                                    <label class="form-label mb-1 small">Approval Type</label>
                                    <select name="approverType" class="selectpicker form-control form-control-sm gr-select"
                                            data-style="btn-default" data-width="100%">
                                        <option value="">All Types</option>
                                        @foreach (var option in approverTypeOptions)
                                        {
                                            <option value="@option.DocumentType" selected="@(option.DocumentType.ToString().Equals(ViewBag.ApproverType?.ToString()) ? "selected" : null)">@option.ApproverTypeName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Clear</a>
                            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Approval Type</th>
                    <th>Document Number</th>
                    <th>Current Level</th>
                    <th>Requested At</th>
                    <th>Aging</th>
                    <th class="text-center" style="width: 110px;">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center">No approvals pending on you.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var item in Model.Items)
                    {
                        rowNo++;
                        var agingColor = item.AgingDays >= 3 ? "danger" : item.AgingDays >= 1 ? "warning" : "secondary";
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@item.ApproverTypeName</td>
                            <td>@item.DocumentNumber</td>
                            <td>@item.LevelName</td>
                            <td>@item.RequestedAt.ToLocalTime().ToString("g")</td>
                            <td><span class="badge bg-label-@agingColor">@item.AgingDays day@(item.AgingDays == 1 ? "" : "s")</span></td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-icon btn-text-secondary"
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="View Detail">
                                        <i class="ri ri-eye-line icon-14px"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        initSelectpickers();
    });
</script>
