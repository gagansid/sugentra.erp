@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Inventory.StockLedger>
@{
    ViewData["Title"] = "Stock Ledgers";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-file-list-3-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Stock Ledgers", null)
    });
    var hasAdvancedFilter = !string.IsNullOrEmpty(ViewBag.MovementType as string)
        || ViewBag.WarehouseId != null || ViewBag.DateFrom != null || ViewBag.DateTo != null;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Stock Ledgers (Kartu Stok)</h5>
    </div>
    <!-- _ShowEntries partial's own <form>, avoiding invalid nested <form> elements -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 mb-2">
        @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        <form method="get" id="stockLedgersFilterForm" class="d-flex align-items-center gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   style="width: 250px;" value="@ViewBag.Keyword" placeholder="Search item, reference.." />
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-primary position-relative"
                        id="stockLedgersFilterDropdown" data-bs-toggle="dropdown"
                        data-bs-auto-close="outside" aria-expanded="@(hasAdvancedFilter ? "true" : "false")">
                    <i class="ri ri-filter-3-line me-1"></i>Filter
                    @if (hasAdvancedFilter)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                            <span class="visually-hidden">Filter active</span>
                        </span>
                    }
                </button>
                <div class="dropdown-menu dropdown-menu-end w-px-500 p-0" aria-labelledby="stockLedgersFilterDropdown">
                    <div class="card mb-0 shadow-none">
                        <div class="card-header py-2">
                            <h6 class="mb-3">Filter</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-6 mb-2">
                                    <label class="form-label mb-1 small">Movement Type</label>
                                    <select name="movementType" class="form-select form-select-sm">
                                        <option value="">All Movement Types</option>
                                        @foreach (var type in new[] { "Receipt", "Mutation", "ToVendor", "FromVendor", "Consumption",
             "Adjustment", "Reservation", "Release", "Shipped" })
                                        {
                                            <option value="@type" selected="@(type.Equals(ViewBag.MovementType) ? "selected" : null)">@type
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label mb-1 small">Warehouse</label>
                                    <select name="warehouseId" class="form-select form-select-sm">
                                        <option value="">All Warehouses</option>
                                        @foreach (var warehouse in warehouses)
                                        {
                                            <option value="@warehouse.Id" selected="@(warehouse.Id.ToString().Equals(ViewBag.WarehouseId?.ToString()) ? "selected" : null)">@warehouse.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label mb-1 small">Date From</label>
                                    <input name="dateFrom" type="text" class="form-control form-control-sm stock-ledger-date-flatpickr"
                                           autocomplete="off"
                                           value="@(ViewBag.DateFrom != null ? ((DateTime)ViewBag.DateFrom).ToString("yyyy-MM-dd") : null)" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label mb-1 small">Date To</label>
                                    <input name="dateTo" type="text" class="form-control form-control-sm stock-ledger-date-flatpickr"
                                           autocomplete="off"
                                           value="@(ViewBag.DateTo != null ? ((DateTime)ViewBag.DateTo).ToString("yyyy-MM-dd") : null)" />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Clear</a>
                            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th>Date</th>
                    <th>Item</th>
                    <th>Warehouse</th>
                    <th>Movement Type</th>
                    <th class="text-end">Qty Change</th>
                    <th class="text-end">Unit Cost</th>
                    <th>Reference</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-muted text-center">No stock ledger entries recorded.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var entry in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@entry.MovementDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@(items.FirstOrDefault(i => i.Id == entry.ItemId)?.Name)</td>
                            <td>@(warehouses.FirstOrDefault(w => w.Id == entry.WarehouseId)?.Name)</td>
                            <td><span class="badge bg-label-primary">@entry.MovementType</span></td>
                            <td class="text-end">@entry.QuantityChange.ToString("N4")</td>
                            <td class="text-end">@entry.UnitCost.ToString("N4")</td>
                            <td>@entry.ReferenceType #@entry.ReferenceId</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.stock-ledger-date-flatpickr').forEach(function (input) {
            flatpickr(input, { dateFormat: 'Y-m-d', allowInput: true, appendTo: document.body });
        });
    });
</script>
