@* Reusable delete-confirmation modal. Render once per page via @await Html.PartialAsync("_DeleteConfirmModal", "Batch")
   and trigger with onclick="confirmDelete(this, { modalId: '...' })" (see site.js). *@
@model string
@{
    var entityLabel = Model ?? "Item";
    var modalId = ViewData["ModalId"] as string ?? "deleteConfirmModal";
}
<div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="@(modalId)Form" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Delete @entityLabel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete <strong id="@(modalId)Name"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-dark waves-effect btn-filter-action"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-filter-action">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
