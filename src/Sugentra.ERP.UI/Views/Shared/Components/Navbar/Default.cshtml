@model Sugentra.ERP.UI.Models.Layout.NavbarViewModel

<nav class="layout-navbar container-fluid navbar navbar-expand-xl align-items-center bg-navbar-theme"
     id="layout-navbar">
  <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
    <a class="nav-item nav-link px-0" href="javascript:void(0)">
      <i class="icon-base ri ri-menu-line icon-22px"></i>
    </a>
  </div>

  @if (Model.ShowBrand)
  {
    <div class="navbar-nav-brand d-flex align-items-center me-4">
      @if (!string.IsNullOrEmpty(Model.LogoUrl))
      {
        <img src="@Model.LogoUrl" alt="@Model.CompanyName" style="block-size: 28px; inline-size: auto;" />
      }
      else
      {
        <span class="fw-semibold">@Model.CompanyName</span>
      }
    </div>
  }

  <div class="navbar-nav-right d-flex align-items-center justify-content-end w-100" id="navbar-collapse">
    <ul class="navbar-nav flex-row align-items-center ms-auto">
      <li class="nav-item navbar-dropdown dropdown-user dropdown">
        <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
          <div class="avatar avatar-online">
            <span class="avatar-initial rounded-circle bg-label-primary">@Model.Username.Substring(0,
                            1).ToUpper()</span>
            </div>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <a class="dropdown-item" href="javascript:void(0);">
                <i class="ri ri-user-line ri-20px me-2"></i>
                <span class="fw-medium">@Model.Username</span>
              </a>
            </li>
            <li>
              <div class="dropdown-divider"></div>
            </li>
            <li>
              <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="dropdown-item">
                  <i class="ri ri-logout-box-r-line ri-20px me-2"></i>
                  <span>Log Out</span>
                </button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </nav>

