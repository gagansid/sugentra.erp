@model Sugentra.ERP.UI.Models.Inventory.StockMutationResponse
@{
    ViewData["Title"] = "Stock Mutation Detail";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-arrow-left-right-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Stock Mutations", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem(Model.MutationNumber, null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            Stock Mutation @Model.MutationNumber
            <span class="badge bg-label-@(Model.Status switch
                                           {
                                               "Draft" => "secondary",
                                               "Approved" => "info",
                                               "Completed" => "success",
                                               _ => "secondary"
                                           }) ms-2">@Model.Status</span>
        </h5>
        <div class="d-flex gap-2">
            @if (Model.Status == "Draft" && User.HasPermission("StockMutation_Edit"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-label-dark"><i
                    class="ri ri-edit-line me-1"></i>Edit</a>
                    <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary"><i
                            class="ri ri-check-line me-1"></i>Approve</button>
                        </form>
                    }
                    @if (Model.Status == "Approved" && User.HasPermission("StockMutation_Edit"))
                    {
                        <form method="post" asp-action="Complete" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary"><i
                                class="ri ri-check-double-line me-1"></i>Complete</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-hover mb-0 detail-info-table">
                        <tbody>
                            <tr>
                                <td>Type</td>
                                <td class="fw-bold">@Model.MutationType</td>
                            </tr>
                            <tr>
                                <td>Source Warehouse</td>
                                <td>@(warehouses.FirstOrDefault(w => w.Id == Model.SourceWarehouseId)?.Name)</td>
                            </tr>
                            <tr>
                                <td>Destination Warehouse</td>
                                <td>@(warehouses.FirstOrDefault(w => w.Id == Model.DestinationWarehouseId)?.Name)</td>
                            </tr>
                            <tr>
                                <td>Vendor Reference</td>
                                <td>@Model.VendorReference</td>
                            </tr>
                            <tr>
                                <td>Mutation Date</td>
                                <td>@Model.MutationDate.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td>Notes</td>
                                <td>@Model.Notes</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lines</h5>
                </div>
                <div class="table-responsive text-nowrap">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Batch</th>
                                <th class="text-end">Quantity</th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name)</td>
                                    <td>@(batches.FirstOrDefault(b => b.Id == line.BatchId)?.Code)</td>
                                    <td class="text-end">@line.Quantity.ToString("N4")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
