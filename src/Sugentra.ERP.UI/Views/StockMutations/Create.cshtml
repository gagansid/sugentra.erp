@{
    ViewData["Title"] = "Add Stock Mutation";
    var items = (IReadOnlyList<Sugentra.ERP.UI.Models.MasterData.Item>)ViewBag.Items;
    var warehouses = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Warehouse>)ViewBag.Warehouses;
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-arrow-left-right-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Stock Mutations", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Create", null)
    });
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form id="mutationForm" method="post" novalidate>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Mutation Type</label>
                <div class="col-md-4 col-sm-8">
                    <select name="mutationType" class="selectpicker form-control form-control-sm gr-select" data-style="btn-default"
                            data-width="100%" required data-required-message="Mutation type is required.">
                        <option value="Internal">Internal (Warehouse to Warehouse)</option>
                        <option value="ToVendor">To Vendor</option>
                        <option value="FromVendor">From Vendor</option>
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Source Warehouse</label>
                <div class="col-md-4 col-sm-8">
                    <select name="sourceWarehouseId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%" required data-required-message="Source warehouse is required.">
                        <option value="" selected disabled>-- Select Warehouse --</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Code - @w.Name</option>
                        }
                    </select>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Destination Warehouse</label>
                <div class="col-md-4 col-sm-8">
                    <select name="destinationWarehouseId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                            data-style="btn-default" data-width="100%">
                        <option value="">-- None --</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Code - @w.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Vendor Reference</label>
                <div class="col-md-4 col-sm-8"><input name="vendorReference" class="form-control form-control-sm" /></div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm required-label">Mutation Date</label>
                <div class="col-md-4 col-sm-8">
                    <div class="input-group input-group-sm received-date-group">
                        <input name="mutationDate" type="text" class="form-control form-control-sm received-date-flatpickr"
                               autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required data-required-message="Mutation date is required." />
                        <span class="input-group-text received-date-toggle"><i class="ri ri-calendar-line"></i></span>
                    </div>
                    <div class="text-danger small line-error"></div>
                </div>
            </div>
            <div class="row g-2">
                <label class="col-md-2 col-sm-4 col-form-label col-form-label-sm">Notes</label>
                <div class="col-md-4 col-sm-8"><textarea name="notes" class="form-control form-control-sm" rows="4"></textarea></div>
            </div>

            <h6 class="mb-3">Lines</h6>
            <div class="row g-2 mb-1">
                <label class="col-md-3 form-label mb-0 small">Batch</label>
                <label class="col-md-6 form-label mb-0 small required-label">Item</label>
                <label class="col-md-3 form-label mb-0 small required-label">Quantity</label>
            </div>
            <div id="lines">
                <div class="row g-2 mb-2 line-row">
                    <div class="col-md-3">
                        <select name="batchId" class="selectpicker form-control form-control-sm gr-select batch-select" data-live-search="true"
                                data-style="btn-default" data-width="100%">
                            <option value="">-- No Batch --</option>
                            @foreach (var batch in batches)
                            {
                                <option value="@batch.Id" data-item-id="@batch.ItemId">@batch.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select class="selectpicker form-control form-control-sm gr-select item-select" data-live-search="true"
                                data-style="btn-default" data-width="100%">
                            <option value="">-- Select Item --</option>
                            @foreach (var item in items)
                            {
                                <option value="@item.Id">@item.Code - @item.Name</option>
                            }
                        </select>
                        <input type="hidden" name="itemId" class="item-hidden" value="" />
                        <div class="text-danger small line-error item-error"></div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group input-group-sm has-validation unit-cost-group">
                            <input name="quantity" type="number" step="0.0001" class="form-control form-control-sm"
                                   placeholder="Qty" required data-required-message="Quantity is required." />
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" data-bs-toggle="tooltip"
                                    title="Remove">
                                <i class="ri ri-delete-bin-line icon-14px"></i>
                            </button>
                        </div>
                        <div class="text-danger small line-error"></div>
                    </div>
                </div>
            </div>
            <button type="button" id="addLine" class="btn btn-sm btn-outline-primary mb-4">+ Add Line</button>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
        <button type="submit" form="mutationForm" class="btn btn-primary btn-sm btn-filter-action">Save</button>
    </div>
</div>

@section Scripts {
    <script>
        // Self-heals against double-wrapping the same <select> (bootstrap-select always
        // wraps on init) so re-initializing a clone doesn't create a duplicated menu.
        function initSelectPickers($scope) {
            $scope.find('select.gr-select').each(function () {
                var $select = $(this);
                if ($select.closest('.bootstrap-select').length) {
                    $select.selectpicker('destroy');
                }
                $select.selectpicker();
            });
        }

        // selectpicker('refresh') duplicates the rendered title text in this bootstrap-select build,
        // so re-render by destroying and re-initializing the widget instead.
        function rerenderSelectPicker($select) {
            $select.selectpicker('destroy');
            $select.selectpicker();
        }

        $(function () {
            initSelectPickers($(document));
            initDateGroupPickers('.received-date-flatpickr');
        });

        // Shows the small `data-required-message` text under a required field, or clears it when valid.
        function setFieldError(field, message) {
            var errorEl = field.closest('.col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-sm-8')?.querySelector('.line-error');
            if (errorEl) errorEl.textContent = message || '';
        }

        function syncItemFromBatch(row) {
            var batchSelect = row.querySelector('select.batch-select');
            var itemSelect = row.querySelector('select.item-select');
            var itemHidden = row.querySelector('.item-hidden');
            var selectedOption = batchSelect.options[batchSelect.selectedIndex];
            var itemId = selectedOption ? (selectedOption.getAttribute('data-item-id') || '') : '';
            if (itemId) {
                // Batch has a known item — lock the Item picker to it, no manual override.
                $(itemSelect).val(itemId);
                itemSelect.disabled = true;
                rerenderSelectPicker($(itemSelect));
                itemHidden.value = itemId;
                var itemErrorEl = row.querySelector('.item-error');
                if (itemErrorEl) itemErrorEl.textContent = '';
            } else {
                // No batch selected — let the user pick the Item manually.
                itemSelect.disabled = false;
                rerenderSelectPicker($(itemSelect));
                itemHidden.value = itemSelect.value || '';
            }
        }

        document.getElementById('addLine').addEventListener('click', function () {
            var lines = document.getElementById('lines');
            var clone = lines.firstElementChild.cloneNode(true);
            // cloneNode copies the rendered bootstrap-select wrapper markup, not the jQuery plugin
            // instance — drop it and any ids before re-initializing to avoid cross-wired toggles.
            clone.querySelectorAll('.bootstrap-select').forEach(function (wrapper) {
                wrapper.replaceWith(wrapper.querySelector('select'));
            });
            clone.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
            clone.querySelectorAll('input:not(.item-hidden)').forEach(function (i) { i.value = ''; });
            clone.querySelector('.item-hidden').value = '';
            clone.querySelector('select.batch-select').value = '';
            var clonedItemSelect = clone.querySelector('select.item-select');
            clonedItemSelect.value = '';
            clonedItemSelect.disabled = false;
            clone.querySelectorAll('.line-error').forEach(function (el) { el.textContent = ''; });
            lines.appendChild(clone);
            initSelectPickers($(clone));
        });

        $('#lines').on('change', '.batch-select', function (e) {
            syncItemFromBatch(e.target.closest('.line-row'));
        });

        $('#lines').on('change', '.item-select', function (e) {
            var row = e.target.closest('.line-row');
            var itemHidden = row.querySelector('.item-hidden');
            itemHidden.value = e.target.value || '';
            if (itemHidden.value) {
                var itemErrorEl = row.querySelector('.item-error');
                if (itemErrorEl) itemErrorEl.textContent = '';
            }
        });

        document.getElementById('lines').addEventListener('click', function (e) {
            var btn = e.target.closest('.remove-line');
            if (!btn) return;
            var lines = document.getElementById('lines');
            var row = btn.closest('.line-row');
            if (lines.children.length > 1) {
                row.remove();
            } else {
                row.querySelectorAll('input:not(.item-hidden)').forEach(function (i) { i.value = ''; });
                row.querySelector('.item-hidden').value = '';
                row.querySelector('select.batch-select').value = '';
                var rowItemSelect = row.querySelector('select.item-select');
                rowItemSelect.value = '';
                rowItemSelect.disabled = false;
                initSelectPickers($(row));
                row.querySelectorAll('.line-error').forEach(function (el) { el.textContent = ''; });
            }
        });

        $('#mutationForm').on('change input', 'select.gr-select, input[required]', function () {
            if (this.checkValidity()) setFieldError(this, '');
        });

        document.getElementById('mutationForm').addEventListener('submit', function (event) {
            var valid = true;
            this.querySelectorAll('[required]').forEach(function (field) {
                var isFieldValid = field.checkValidity();
                setFieldError(field, isFieldValid ? '' : field.dataset.requiredMessage);
                valid = valid && isFieldValid;
            });
            document.querySelectorAll('.item-hidden').forEach(function (hidden) {
                var isValid = !!hidden.value;
                var itemErrorEl = hidden.closest('.line-row').querySelector('.item-error');
                if (itemErrorEl) itemErrorEl.textContent = isValid ? '' : 'Item is required.';
                valid = valid && isValid;
            });
            if (!valid) {
                event.preventDefault();
                event.stopPropagation();
            }
        });
    </script>
}
