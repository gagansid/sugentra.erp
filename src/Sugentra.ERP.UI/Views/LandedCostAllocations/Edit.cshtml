@model Sugentra.ERP.UI.Models.Inventory.LandedCostAllocation
@{
    ViewData["Title"] = "Edit Landed Cost Allocation";
    var batches = (IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.Batch>)ViewBag.Batches;
    var currencies = (IReadOnlyList<Sugentra.ERP.UI.Models.Settings.Currency>)ViewBag.Currencies;
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-coin-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Inventory", Url.Action("Index", "Workspace", new { id = "Inventory" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Landed Cost Allocations", Url.Action("Index")),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("Edit", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
}

<div class="row">
    <div class="col-md-6 col-sm-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                <form id="landedCostAllocationForm" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-2 align-items-center">
                        <label class="col-md-4 col-sm-4 col-form-label col-form-label-sm required-label">Batch</label>
                        <div class="col-md-8 col-sm-8">
                            <select asp-for="BatchId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                                    data-style="btn-default" data-width="100%" required data-required-message="Batch is required.">
                                @foreach (var batch in batches)
                                {
                                    <option value="@batch.Id" selected="@(batch.Id == Model.BatchId ? "selected" : null)">@batch.Code</option>
                                }
                            </select>
                            <span asp-validation-for="BatchId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">
                        <label class="col-md-4 col-sm-4 col-form-label col-form-label-sm required-label">Cost Type</label>
                        <div class="col-md-8 col-sm-8">
                            <select asp-for="CostType" class="selectpicker form-control form-control-sm gr-select"
                                    data-style="btn-default" data-width="100%" required data-required-message="Cost type is required.">
                                @foreach (var costType in new[] { "Freight", "Insurance", "Handling", "Duty", "Other" })
                                {
                                    <option value="@costType" selected="@(costType == Model.CostType ? "selected" : null)">@costType</option>
                                }
                            </select>
                            <span asp-validation-for="CostType" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">
                        <label asp-for="Amount" class="col-md-4 col-sm-4 col-form-label col-form-label-sm required-label">Amount</label>
                        <div class="col-md-8 col-sm-8">
                            <input asp-for="Amount" type="number" step="0.01" class="form-control form-control-sm"
                                   value="@Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   required data-required-message="Amount is required." />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">
                        <label class="col-md-4 col-sm-4 col-form-label col-form-label-sm required-label">Currency</label>
                        <div class="col-md-8 col-sm-8">
                            <select asp-for="CurrencyId" class="selectpicker form-control form-control-sm gr-select" data-live-search="true"
                                    data-style="btn-default" data-width="100%" required data-required-message="Currency is required.">
                                @foreach (var currency in currencies)
                                {
                                    <option value="@currency.Id" selected="@(currency.Id == Model.CurrencyId ? "selected" : null)">@currency.Code - @currency.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CurrencyId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">
                        <label asp-for="Notes" class="col-md-4 col-sm-4 col-form-label col-form-label-sm">Notes</label>
                        <div class="col-md-8 col-sm-8">
                            <textarea asp-for="Notes" class="form-control form-control-sm" rows="2"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-label-dark waves-effect btn-sm btn-filter-action">Cancel</a>
                <button type="submit" form="landedCostAllocationForm" class="btn btn-primary btn-sm btn-filter-action">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initSelectpickers();
            var form = document.getElementById('landedCostAllocationForm');
            if (!form) return;

            function fieldMessageEl(field) {
                return field.closest('.col-md-8, .col-sm-8')?.querySelector('.text-danger');
            }

            function clearFieldMessage(field) {
                if (!field.checkValidity()) return;
                var msgEl = fieldMessageEl(field);
                if (msgEl) msgEl.textContent = '';
            }

            form.querySelectorAll('[required]').forEach(function (field) {
                field.addEventListener('input', function () { clearFieldMessage(field); });
                field.addEventListener('change', function () { clearFieldMessage(field); });
            });

            form.addEventListener('submit', function (event) {
                var valid = true;
                form.querySelectorAll('[required]').forEach(function (field) {
                    var isFieldValid = field.checkValidity();
                    var msgEl = fieldMessageEl(field);
                    if (msgEl) msgEl.textContent = isFieldValid ? '' : (field.dataset.requiredMessage || 'This field is required.');
                    valid = valid && isFieldValid;
                });
                if (!valid) { event.preventDefault(); event.stopPropagation(); }
            });
        });
    </script>
}
