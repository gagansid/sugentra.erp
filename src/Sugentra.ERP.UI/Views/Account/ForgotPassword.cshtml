@model Sugentra.ERP.UI.Models.Account.ForgotPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="authentication-wrapper authentication-basic container-p-y p-4 p-sm-0">
    <div class="authentication-inner py-6">
        <div class="card p-md-7 p-1">
            <div class="app-brand justify-content-center mt-5">
                <a asp-controller="Account" asp-action="Login" class="app-brand-link gap-2">
                    @if (!string.IsNullOrEmpty((string?)ViewBag.LogoUrl))
                    {
                        <img src="@ViewBag.LogoUrl" alt="@(ViewBag.CompanyName ?? "Sugentra ERP")"
                             style="block-size: 72px; inline-size: auto;" />
                    }
                    else
                    {
                        <span class="app-brand-text demo text-heading fw-semibold">@(ViewBag.CompanyName ?? "Sugentra ERP")</span>
                    }
                </a>
            </div>
            <div class="card-body mt-1">
                <p class="mb-5">Enter your email and we'll send you a reset code.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-primary" role="alert">@successMessage</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="mb-5">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control form-control-sm" placeholder="Enter your email"
                               autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <button class="btn btn-primary d-grid w-100" type="submit">Send Reset Code</button>
                    </div>
                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none">Back to Sign In</a>
                    </div>
                </form>
            </div>
        </div>
        <p class="text-center mt-4 mb-0 text-body-secondary" style="font-size: 0.75rem;">Sugentra ERP v1.0.0</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
