@model Sugentra.ERP.UI.Models.PagedResult<Sugentra.ERP.UI.Models.Settings.SystemParameterListItemDto>
@{
    ViewData["Title"] = "System Parameters";
    var breadcrumb = new Sugentra.ERP.UI.Models.Layout.BreadcrumbViewModel("ri-sliders-line", new[]
    {
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("System Administration", Url.Action("Index", "Workspace", new { id = "SystemAdministration" })),
        new Sugentra.ERP.UI.Models.Layout.BreadcrumbItem("System Parameters", null)
    });
}

@await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml", breadcrumb)

<div class="card">
    <h5 class="card-header">System Parameters</h5>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-4 mb-2"
         style="padding-left: var(--bs-card-cap-padding-x); padding-right: var(--bs-card-cap-padding-x);">
        <div>
            @await Html.PartialAsync("_ShowEntries", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="text" name="category" class="form-control form-control-sm" style="max-width: 160px;"
                   value="@ViewBag.Category" placeholder="Category" />
            <input type="text" name="search" class="form-control form-control-sm" style="max-width: 200px;"
                   value="@ViewBag.Search" placeholder="Search key/value/description..." />
            <select name="isActive" class="form-select form-select-sm" style="max-width: 130px;">
                <option value="">All Status</option>
                <option value="true" selected="@(true.Equals(ViewBag.IsActive) ? "selected" : null)">Active</option>
                <option value="false" selected="@(false.Equals(ViewBag.IsActive) ? "selected" : null)">Inactive</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary btn-filter-action">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-label-dark waves-effect btn-filter-action">Reset</a>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">No</th>
                    <th class="col-fit">Category</th>
                    <th>Key</th>
                    <th>Value</th>
                    <th>Description</th>
                    <th class="col-fit">Status</th>
                    <th class="text-center" style="width: 80px;">Edit</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center">No system parameters found.</td>
                    </tr>
                }
                else
                {
                    var rowNo = (Model.Page - 1) * Model.PageSize;
                    @foreach (var param in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td class="text-center">@rowNo</td>
                            <td>@(param.ParamCategory ?? "-")</td>
                            <td>@param.ParamKey</td>
                            <td>@(param.ParamValue ?? "-")</td>
                            <td>@(param.Description ?? "-")</td>
                            <td>
                                @if (param.IsActive)
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (User.HasPermission("SystemParameter_Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@param.Id" class="btn btn-icon btn-text-secondary"
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i
                                        class="ri ri-edit-line icon-14px"></i></a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_PagingFooter", Sugentra.ERP.UI.Models.Layout.PagingInfo.From(Model))
</div>
