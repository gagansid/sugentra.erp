@model IReadOnlyList<Sugentra.ERP.UI.Models.Layout.MenuNodeDto>

<div class="mb-5">
    <h4 class="mb-1"><i class="icon-base ri @ViewBag.ModuleIcon me-2"></i>@ViewBag.ModuleTitle</h4>
    <p class="mb-0 text-body-secondary">Select a page to get started.</p>
</div>

<div class="d-flex flex-wrap gap-4">
    @foreach (var item in Model)
    {
        <a asp-controller="@item.Controller" asp-action="@item.Action" class="module-tile">
            <span class="module-tile-box">
                <i class="icon-base ri @item.Icon module-tile-icon"></i>
            </span>
            <p class="module-tile-name">@item.Name</p>
        </a>
    }
</div>
