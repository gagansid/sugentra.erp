@model Sugentra.ERP.UI.Models.Inventory.InventoryStats
@{
    // Renders one colored card per entity: icon + total on top, plus a status-breakdown badge row below, so
    // every condition in the Inventory module (Draft/WaitingApproval/Posted, OnHold/Released/Rejected, ...)
    // is visible on the dashboard instead of a single aggregate number.
    void RenderCard(string idPrefix, string color, string icon, string title, IReadOnlyList<Sugentra.ERP.UI.Models.Inventory.StatusBreakdown>? breakdown)
    {
        if (breakdown is null) return;
        var total = breakdown.Sum(b => b.Count);
        <div class="col-md-3 col-sm-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center flex-wrap mb-3">
                        <div class="avatar me-4">
                            <div class="avatar-initial bg-label-@color rounded-3">
                                <i class="icon-base ri @icon icon-24px"></i>
                            </div>
                        </div>
                        <div class="card-info">
                            <h5 class="mb-0" id="@(idPrefix)Total">@total</h5>
                            <p class="mb-0">@title</p>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var status in breakdown)
                        {
                            <span class="badge bg-label-@color" id="@(idPrefix)@(status.Status.Replace(" ", ""))">@status.Status: @status.Count</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (Model.TotalItems is not null)
{
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center flex-wrap">
                <div class="avatar me-4">
                    <div class="avatar-initial bg-label-primary rounded-3">
                        <i class="icon-base ri ri-archive-2-line icon-24px"></i>
                    </div>
                </div>
                <div class="card-info">
                    <h5 class="mb-0" id="statTotalItems">@Model.TotalItems</h5>
                    <p class="mb-0">Total Items</p>
                </div>
            </div>
        </div>
    </div>
}
@if (Model.TotalBatches is not null)
{
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center flex-wrap">
                <div class="avatar me-4">
                    <div class="avatar-initial bg-label-info rounded-3">
                        <i class="icon-base ri ri-barcode-box-line icon-24px"></i>
                    </div>
                </div>
                <div class="card-info">
                    <h5 class="mb-0" id="statTotalBatches">@Model.TotalBatches</h5>
                    <p class="mb-0">Total Batches</p>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.TotalStockLedgerEntries is not null)
{
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center flex-wrap">
                <div class="avatar me-4">
                    <div class="avatar-initial bg-label-dark rounded-3">
                        <i class="icon-base ri ri-file-list-3-line icon-24px"></i>
                    </div>
                </div>
                <div class="card-info">
                    <h5 class="mb-0" id="statTotalStockLedgerEntries">@Model.TotalStockLedgerEntries</h5>
                    <p class="mb-0">Stock Ledger Entries</p>
                </div>
            </div>
        </div>
    </div>
}
@if (Model.StockBalances is not null)
{
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center flex-wrap mb-3">
                    <div class="avatar me-4">
                        <div class="avatar-initial bg-label-primary rounded-3">
                            <i class="icon-base ri ri-stack-line icon-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h5 class="mb-0" id="statStockBalanceOnHand">@Model.StockBalances.OnHand.ToString("N0")</h5>
                        <p class="mb-0">Stock On Hand</p>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <span class="badge bg-label-primary" id="statStockBalanceReserved">Reserved: @Model.StockBalances.Reserved.ToString("N0")</span>
                    <span class="badge bg-label-primary" id="statStockBalanceInQuarantine">In Quarantine: @Model.StockBalances.InQuarantine.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>
}

@{
    RenderCard("statGoodsReceipts", "success", "ri-truck-line", "Goods Receipts", Model.GoodsReceipts);
    RenderCard("statQuarantineHolds", "danger", "ri-shield-cross-line", "Quarantine Holds", Model.QuarantineHolds);
    RenderCard("statStockMutations", "warning", "ri-arrow-left-right-line", "Stock Mutations", Model.StockMutations);
    RenderCard("statStockMutationTypes", "info", "ri-swap-line", "Stock Mutations by Type", Model.StockMutationTypes);
    RenderCard("statStockOpnames", "secondary", "ri-clipboard-line", "Stock Opnames", Model.StockOpnames);
}

